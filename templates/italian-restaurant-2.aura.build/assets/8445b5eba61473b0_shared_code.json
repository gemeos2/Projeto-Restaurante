[{"id":18733,"slug":"italian-restaurant-2","title":"Italian Restaurant Landing Page Template","code":"<!DOCTYPE html>\n<html lang=\"de\" class=\"scroll-smooth\">\n<head>\n<script>\ntry{if(window.parent&&window.parent!==window){window.parent.promotekit_referral=\"1fd2949a-d22c-431b-92bf-02d4ad04ee24\";window.parent.document.cookie=\"promotekit_referral=1fd2949a-d22c-431b-92bf-02d4ad04ee24;path=/;domain=.aura.build;max-age=31536000\"}}catch(e){}\n</script>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>La Dolce Vita - Echte italienische Leidenschaft</title>\n<script src=\"https://cdn.tailwindcss.com\"></script>\n<script src=\"https://code.iconify.design/iconify-icon/1.0.7/iconify-icon.min.js\"></script>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@300;400;500;600&display=swap\" rel=\"stylesheet\">\n<style>\nbody {\nfont-family: 'Inter', sans-serif;\n}\nh1, h2, h3, h4, .font-serif {\nfont-family: 'Instrument Serif', serif;\n}\n.steam-container {\nposition: absolute;\nbottom: 0;\nleft: 0;\nwidth: 100%;\nheight: 100%;\noverflow: hidden;\npointer-events: none;\nz-index: 10;\n}\n.steam-puff {\nposition: absolute;\nbackground: radial-gradient(circle, rgba(255,255,255,0.2) 0%, rgba(255,255,255,0) 70%);\nborder-radius: 50%;\nfilter: blur(20px);\nopacity: 0;\nanimation: rise 8s infinite ease-out;\n}\n@keyframes rise {\n0% {\ntransform: translateY(100%) scale(0.5) translateX(0);\nopacity: 0;\n}\n20% {\nopacity: 0.4;\n}\n80% {\nopacity: 0.2;\n}\n100% {\ntransform: translateY(-20%) scale(2) translateX(20px);\nopacity: 0;\n}\n}\n.scroll-hide::-webkit-scrollbar {\ndisplay: none;\n}\n.grain {\nposition: fixed;\ntop: 0;\nleft: 0;\nwidth: 100%;\nheight: 100%;\npointer-events: none;\nz-index: 50;\nopacity: 0.03;\nbackground-image: url(\"data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E\");\n}\n</style></head>\n<body class=\"bg-stone-950 text-stone-200 antialiased selection:bg-orange-900 selection:text-white\">\n\n    <!-- Grain Overlay -->\n    <div class=\"grain\"></div>\n\n    <!-- Navigation -->\n    <nav class=\"fixed top-0 w-full z-40 border-b border-white/5 bg-stone-950/80 backdrop-blur-md\">\n        <div class=\"max-w-7xl mx-auto px-6 h-20 flex items-center justify-between\">\n            <a href=\"#\" class=\"text-xl tracking-tighter font-medium text-stone-50 flex items-center gap-2\">\n                LA DOLCE VITA\n            </a>\n            \n            <div class=\"hidden md:flex items-center gap-8 text-sm font-medium text-stone-400\">\n                <a href=\"#menu\" class=\"hover:text-orange-200 transition-colors\">Menü</a>\n                <a href=\"#atmosphere\" class=\"hover:text-orange-200 transition-colors\">Atmosphäre</a>\n                <a href=\"#about\" class=\"hover:text-orange-200 transition-colors\">Über uns</a>\n                <a href=\"#reviews\" class=\"hover:text-orange-200 transition-colors\">Gäste</a>\n            </div>\n\n            <button class=\"bg-stone-100 text-stone-900 px-5 py-2.5 rounded-full text-xs font-semibold tracking-wide hover:bg-stone-200 transition-colors\">\n                RESERVIEREN\n            </button>\n        </div>\n    </nav>\n\n    <!-- Hero Section -->\n    <header class=\"relative w-full h-screen min-h-[600px] flex items-center justify-center overflow-hidden\">\n        <!-- Background Image with Parallax feel -->\n        <div class=\"absolute inset-0 z-0\">\n            <img src=\"https://images.unsplash.com/photo-1621996346565-e3dbc646d9a9?q=80&w=2574&auto=format&fit=crop\" \n                 alt=\"Italian Pasta Macro\" \n                 class=\"w-full h-full object-cover object-center opacity-60 scale-105\">\n            <div class=\"absolute inset-0 bg-gradient-to-t from-stone-950 via-stone-950/60 to-stone-950/30\"></div>\n            <!-- Steam Overlay -->\n            <div class=\"steam-container\">\n                <div class=\"steam-puff w-64 h-64 left-[20%] bottom-[-10%]\" style=\"animation-delay: 0s;\"></div>\n                <div class=\"steam-puff w-96 h-96 right-[20%] bottom-[-20%]\" style=\"animation-delay: 3s;\"></div>\n                <div class=\"steam-puff w-48 h-48 left-[50%] bottom-[-5%]\" style=\"animation-delay: 5s;\"></div>\n            </div>\n        </div>\n\n        <div class=\"relative z-20 text-center max-w-4xl px-6 mt-16\">\n            <div class=\"inline-flex items-center gap-2 px-3 py-1 rounded-full border border-orange-500/30 bg-orange-900/20 text-orange-200 text-xs tracking-widest uppercase mb-6 backdrop-blur-sm\">\n                <iconify-icon icon=\"solar:chef-hat-linear\" width=\"14\" height=\"14\"></iconify-icon>\n                <span>Neu in Berlin Mitte</span>\n            </div>\n            <h1 class=\"text-6xl md:text-8xl lg:text-9xl font-serif italic text-stone-50 leading-[0.9] tracking-tight mb-8\">\n                Echte <span class=\"text-orange-400/90\">italienische</span><br>Leidenschaft.\n            </h1>\n            <p class=\"text-lg md:text-xl text-stone-300 max-w-xl mx-auto font-light leading-relaxed mb-10\">\n                Handgemachte Pasta, holzbefeuerte Pizza und Weine, die Geschichten erzählen. Willkommen in Ihrem zweiten Zuhause.\n            </p>\n            <div class=\"flex flex-col sm:flex-row items-center justify-center gap-4\">\n                <button class=\"group relative px-8 py-4 bg-orange-700 text-orange-50 rounded-full text-sm font-medium tracking-wide overflow-hidden hover:bg-orange-600 transition-all duration-300 shadow-[0_0_40px_-10px_rgba(194,65,12,0.5)]\">\n                    <span class=\"relative z-10 flex items-center gap-2\">\n                        Tisch reservieren\n                        <iconify-icon icon=\"solar:arrow-right-linear\" class=\"group-hover:translate-x-1 transition-transform\"></iconify-icon>\n                    </span>\n                </button>\n                <button class=\"px-8 py-4 bg-transparent border border-stone-700 text-stone-300 rounded-full text-sm font-medium tracking-wide hover:bg-stone-900 hover:border-stone-500 transition-colors\">\n                    Menü ansehen\n                </button>\n            </div>\n        </div>\n    </header>\n\n    <!-- Menu Highlights (Bento Grid) -->\n    <section id=\"menu\" class=\"py-24 md:py-32 bg-stone-950 relative\">\n        <div class=\"max-w-7xl mx-auto px-6\">\n            <div class=\"flex flex-col md:flex-row justify-between items-end mb-16 gap-6\">\n                <div>\n                    <h2 class=\"text-4xl md:text-5xl font-serif text-stone-50 mb-4 tracking-tight\">Unsere Spezialitäten</h2>\n                    <p class=\"text-stone-400 font-light max-w-md\">Saisonale Zutaten treffen auf jahrhundertealte Traditionen.</p>\n                </div>\n                <a href=\"#\" class=\"text-orange-400 text-sm hover:text-orange-300 transition-colors flex items-center gap-1 group\">\n                    Alle Gerichte <iconify-icon icon=\"solar:arrow-right-up-linear\" class=\"group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform\"></iconify-icon>\n                </a>\n            </div>\n\n            <div class=\"grid grid-cols-1 md:grid-cols-3 gap-6 auto-rows-[400px]\">\n                \n                <!-- Pasta Card -->\n                <div class=\"group relative md:col-span-2 rounded-3xl overflow-hidden bg-stone-900 border border-white/5\">\n                    <img src=\"https://images.unsplash.com/photo-1551183053-bf91a1d81141?q=80&w=1600&auto=format&fit=crop\" \n                         class=\"absolute inset-0 w-full h-full object-cover opacity-60 group-hover:scale-105 transition-transform duration-700\" alt=\"Pasta\">\n                    <div class=\"absolute inset-0 bg-gradient-to-t from-stone-950 via-stone-950/20 to-transparent\"></div>\n                    <div class=\"absolute bottom-0 left-0 p-8 w-full\">\n                        <div class=\"flex justify-between items-end\">\n                            <div>\n                                <span class=\"text-orange-400 text-xs tracking-widest uppercase mb-2 block font-medium\">Fatto a Mano</span>\n                                <h3 class=\"text-3xl font-serif text-white mb-2\">Tagliatelle al Tartufo</h3>\n                                <p class=\"text-stone-300 text-sm font-light max-w-sm line-clamp-2\">Frische schwarze Trüffel, Parmesan-Creme, Butteremulsion, Schnittlauch.</p>\n                            </div>\n                            <span class=\"text-2xl font-serif italic text-stone-200\">24€</span>\n                        </div>\n                    </div>\n                </div>\n\n                <!-- Pizza Card -->\n                <div class=\"group relative md:col-span-1 rounded-3xl overflow-hidden bg-stone-900 border border-white/5\">\n                    <img src=\"https://images.unsplash.com/photo-1565299624946-b28f40a0ae38?q=80&w=800&auto=format&fit=crop\" \n                         class=\"absolute inset-0 w-full h-full object-cover opacity-60 group-hover:scale-105 transition-transform duration-700\" alt=\"Pizza\">\n                    <div class=\"absolute inset-0 bg-gradient-to-t from-stone-950 via-stone-950/20 to-transparent\"></div>\n                    <div class=\"absolute bottom-0 left-0 p-8 w-full\">\n                        <span class=\"text-orange-400 text-xs tracking-widest uppercase mb-2 block font-medium\">Aus dem Steinofen</span>\n                        <h3 class=\"text-3xl font-serif text-white mb-2\">Pizza Burrata</h3>\n                        <div class=\"flex justify-between items-center mt-4 border-t border-white/10 pt-4\">\n                            <span class=\"text-stone-300 text-xs\">San Marzano Tomaten</span>\n                            <span class=\"text-xl font-serif italic text-stone-200\">18€</span>\n                        </div>\n                    </div>\n                </div>\n\n                <!-- Dolci Card -->\n                <div class=\"group relative md:col-span-1 rounded-3xl overflow-hidden bg-stone-900 border border-white/5\">\n                    <img src=\"https://images.unsplash.com/photo-1551024709-8f23befc6f87?q=80&w=800&auto=format&fit=crop\" \n                         class=\"absolute inset-0 w-full h-full object-cover opacity-60 group-hover:scale-105 transition-transform duration-700\" alt=\"Dolci\">\n                    <div class=\"absolute inset-0 bg-gradient-to-t from-stone-950 via-stone-950/20 to-transparent\"></div>\n                    <div class=\"absolute bottom-0 left-0 p-8 w-full\">\n                        <span class=\"text-orange-400 text-xs tracking-widest uppercase mb-2 block font-medium\">Süßer Abschluss</span>\n                        <h3 class=\"text-3xl font-serif text-white mb-2\">Tiramisù Classico</h3>\n                        <div class=\"flex justify-between items-center mt-4 border-t border-white/10 pt-4\">\n                            <span class=\"text-stone-300 text-xs\">Espresso, Mascarpone</span>\n                            <span class=\"text-xl font-serif italic text-stone-200\">9€</span>\n                        </div>\n                    </div>\n                </div>\n\n                <!-- Wine Card -->\n                <div class=\"group relative md:col-span-2 rounded-3xl overflow-hidden bg-stone-900 border border-white/5 flex items-center justify-center\">\n                     <img src=\"https://images.unsplash.com/photo-1510812431401-41d2bd2722f3?q=80&w=1600&auto=format&fit=crop\" \n                         class=\"absolute inset-0 w-full h-full object-cover opacity-50 group-hover:scale-105 transition-transform duration-700\" alt=\"Wine\">\n                    <div class=\"absolute inset-0 bg-stone-950/40\"></div>\n                    <div class=\"relative z-10 text-center p-8\">\n                        <iconify-icon icon=\"solar:wineglass-linear\" class=\"text-orange-400 text-4xl mb-4\"></iconify-icon>\n                        <h3 class=\"text-3xl font-serif text-white mb-2\">Unsere Weinkarte</h3>\n                        <p class=\"text-stone-300 text-sm font-light mb-6\">Über 50 handverlesene Weine aus der Toskana.</p>\n                        <button class=\"px-6 py-2 border border-white/20 rounded-full text-xs hover:bg-white hover:text-black transition-all\">Karte öffnen</button>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Chef's Note -->\n    <section id=\"about\" class=\"py-24 bg-stone-900/50\">\n        <div class=\"max-w-7xl mx-auto px-6\">\n            <div class=\"grid grid-cols-1 lg:grid-cols-2 gap-16 items-center\">\n                <div class=\"relative\">\n                    <div class=\"absolute -top-4 -left-4 w-24 h-24 border-t border-l border-orange-500/30 rounded-tl-3xl\"></div>\n                    <div class=\"absolute -bottom-4 -right-4 w-24 h-24 border-b border-r border-orange-500/30 rounded-br-3xl\"></div>\n                    <img src=\"https://images.unsplash.com/photo-1583394293214-28ded15ee548?q=80&w=1200&auto=format&fit=crop\" \n                         alt=\"Chef\" \n                         class=\"w-full rounded-2xl grayscale hover:grayscale-0 transition-all duration-700 shadow-2xl\">\n                </div>\n                <div>\n                    <div class=\"flex items-center gap-3 mb-6\">\n                         <span class=\"h-px w-8 bg-orange-500\"></span>\n                         <span class=\"text-orange-400 text-xs tracking-widest uppercase\">Der Küchenchef</span>\n                    </div>\n                    <h2 class=\"text-4xl md:text-5xl font-serif text-stone-50 mb-8 leading-tight tracking-tight\">\n                        \"Kochen ist für mich wie <span class=\"text-orange-400 italic\">Architektur</span> des Geschmacks.\"\n                    </h2>\n                    <div class=\"space-y-6 text-stone-400 font-light text-lg leading-relaxed\">\n                        <p>\n                            Aufgewachsen in Bologna, habe ich gelernt, dass die einfachsten Zutaten oft die besten sind. Mehl, Wasser, Eier – und viel Zeit.\n                        </p>\n                        <p>\n                            Im <span class=\"font-serif italic text-white\">La Dolce Vita</span> bringen wir diese Philosophie auf Ihren Teller. Kein Schnickschnack, nur purer, unverfälschter Geschmack, der Erinnerungen weckt.\n                        </p>\n                    </div>\n                    <div class=\"mt-10\">\n                        <p class=\"font-serif text-2xl text-stone-100\">Giovanni Rossi</p>\n                        <p class=\"text-sm text-stone-500 mt-1\">Head Chef & Founder</p>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Atmosphere Gallery -->\n    <section id=\"atmosphere\" class=\"py-24 bg-stone-950\">\n        <div class=\"max-w-7xl mx-auto px-6 mb-12 flex justify-between items-end\">\n             <h2 class=\"text-4xl md:text-5xl font-serif text-stone-50 tracking-tight\">Einblicke</h2>\n             <div class=\"hidden md:flex gap-2\">\n                 <button class=\"w-10 h-10 rounded-full border border-stone-800 flex items-center justify-center text-stone-400 hover:border-orange-500 hover:text-orange-500 transition-colors\">\n                     <iconify-icon icon=\"solar:arrow-left-linear\"></iconify-icon>\n                 </button>\n                 <button class=\"w-10 h-10 rounded-full border border-stone-800 flex items-center justify-center text-stone-400 hover:border-orange-500 hover:text-orange-500 transition-colors\">\n                     <iconify-icon icon=\"solar:arrow-right-linear\"></iconify-icon>\n                 </button>\n             </div>\n        </div>\n        \n        <!-- Scrolling Strip -->\n        <div class=\"flex overflow-x-auto gap-4 pb-8 scroll-hide px-6 -mx-6 md:mx-0 md:px-0\">\n            <div class=\"min-w-[300px] md:min-w-[400px] h-[300px] rounded-xl overflow-hidden relative group\">\n                <img src=\"https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?q=80&w=800\" class=\"w-full h-full object-cover group-hover:scale-110 transition-transform duration-700\" alt=\"Interior\">\n                <div class=\"absolute inset-0 bg-black/20 group-hover:bg-black/0 transition-colors\"></div>\n            </div>\n            <div class=\"min-w-[300px] md:min-w-[400px] h-[300px] rounded-xl overflow-hidden relative group\">\n                <img src=\"https://images.unsplash.com/photo-1559339352-11d035aa65de?q=80&w=800\" class=\"w-full h-full object-cover group-hover:scale-110 transition-transform duration-700\" alt=\"Details\">\n            </div>\n            <div class=\"min-w-[300px] md:min-w-[400px] h-[300px] rounded-xl overflow-hidden relative group\">\n                <img src=\"https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/assets/assets/917d6f93-fb36-439a-8c48-884b67b35381_1600w.jpg\" class=\"w-full h-full object-cover group-hover:scale-110 transition-transform duration-700\" alt=\"Dining\">\n            </div>\n             <div class=\"min-w-[300px] md:min-w-[400px] h-[300px] rounded-xl overflow-hidden relative group\">\n                <img src=\"https://images.unsplash.com/photo-1533777857889-4be7c70b33f7?q=80&w=800\" class=\"w-full h-full object-cover group-hover:scale-110 transition-transform duration-700\" alt=\"Evening\">\n            </div>\n        </div>\n    </section>\n\n    <!-- Reviews -->\n    <section id=\"reviews\" class=\"py-24 border-t border-white/5 bg-stone-900/30\">\n        <div class=\"max-w-4xl mx-auto px-6 text-center\">\n            <iconify-icon icon=\"solar:stars-minimalistic-linear\" class=\"text-4xl text-orange-500 mb-6\"></iconify-icon>\n            <h2 class=\"text-3xl md:text-4xl font-serif text-stone-50 mb-12 tracking-tight\">Das sagen unsere Gäste</h2>\n            \n            <div class=\"grid grid-cols-1 md:grid-cols-2 gap-8 text-left\">\n                <div class=\"p-8 rounded-2xl bg-stone-950 border border-white/5 hover:border-orange-500/30 transition-colors\">\n                    <div class=\"flex gap-1 text-orange-400 mb-4\">\n                        <iconify-icon icon=\"solar:star-bold\"></iconify-icon>\n                        <iconify-icon icon=\"solar:star-bold\"></iconify-icon>\n                        <iconify-icon icon=\"solar:star-bold\"></iconify-icon>\n                        <iconify-icon icon=\"solar:star-bold\"></iconify-icon>\n                        <iconify-icon icon=\"solar:star-bold\"></iconify-icon>\n                    </div>\n                    <p class=\"text-stone-300 italic mb-6\">\"Die beste Carbonara, die ich außerhalb von Rom gegessen habe. Ein absolutes Muss für jeden Feinschmecker.\"</p>\n                    <div class=\"flex items-center gap-3\">\n                        <div class=\"w-10 h-10 rounded-full bg-stone-800 flex items-center justify-center text-stone-500 font-serif\">M</div>\n                        <div>\n                            <p class=\"text-sm text-stone-200 font-medium\">Michael K.</p>\n                            <p class=\"text-xs text-stone-500\">vor 2 Tagen</p>\n                        </div>\n                    </div>\n                </div>\n\n                <div class=\"p-8 rounded-2xl bg-stone-900 border border-white/5 hover:border-orange-500/30 transition-colors\">\n                    <div class=\"flex gap-1 text-orange-400 mb-4\">\n                        <iconify-icon icon=\"solar:star-bold\"></iconify-icon>\n                        <iconify-icon icon=\"solar:star-bold\"></iconify-icon>\n                        <iconify-icon icon=\"solar:star-bold\"></iconify-icon>\n                        <iconify-icon icon=\"solar:star-bold\"></iconify-icon>\n                        <iconify-icon icon=\"solar:star-bold\"></iconify-icon>\n                    </div>\n                    <p class=\"text-stone-300 italic mb-6\">\"Wunderschönes Ambiente und eine Weinkarte, die keine Wünsche offen lässt. Wir kommen definitiv wieder.\"</p>\n                    <div class=\"flex items-center gap-3\">\n                        <div class=\"w-10 h-10 rounded-full bg-stone-800 flex items-center justify-center text-stone-500 font-serif\">S</div>\n                        <div>\n                            <p class=\"text-sm text-stone-200 font-medium\">Sophie W.</p>\n                            <p class=\"text-xs text-stone-500\">vor 1 Woche</p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Reservation & Footer -->\n    <footer class=\"bg-stone-950 pt-24 pb-12 border-t border-white/5\">\n        <div class=\"max-w-7xl mx-auto px-6\">\n            <div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-16\">\n                <!-- Brand -->\n                <div class=\"col-span-1 lg:col-span-1\">\n                    <a href=\"#\" class=\"text-2xl tracking-tighter font-medium text-stone-50 block mb-6\">\n                        LA DOLCE VITA\n                    </a>\n                    <p class=\"text-stone-500 text-sm leading-relaxed mb-6\">\n                        Ein Stück Italien im Herzen der Stadt. Authentisch, herzlich, köstlich.\n                    </p>\n                    <div class=\"flex gap-4\">\n                        <a href=\"#\" class=\"text-stone-400 hover:text-orange-400 transition-colors\"><iconify-icon icon=\"solar:instagram-linear\" width=\"20\"></iconify-icon></a>\n                        <a href=\"#\" class=\"text-stone-400 hover:text-orange-400 transition-colors\"><iconify-icon icon=\"solar:facebook-linear\" width=\"20\"></iconify-icon></a>\n                    </div>\n                </div>\n\n                <!-- OpenTable Placeholder -->\n                <div class=\"col-span-1 lg:col-span-2 p-8 rounded-2xl bg-stone-900/50 border border-white/5 text-center flex flex-col items-center justify-center relative overflow-hidden\">\n                    <div class=\"absolute inset-0 bg-gradient-to-br from-orange-900/10 to-transparent pointer-events-none\"></div>\n                    <iconify-icon icon=\"solar:calendar-linear\" class=\"text-3xl text-orange-400 mb-4\"></iconify-icon>\n                    <h3 class=\"text-xl font-serif text-stone-200 mb-2\">Tisch reservieren</h3>\n                    <p class=\"text-stone-500 text-sm mb-6\">Buchen Sie bequem über OpenTable</p>\n                    \n                    <!-- Simulating Widget UI -->\n                    <div class=\"flex gap-2 w-full max-w-sm\">\n                        <div class=\"flex-1 h-10 bg-stone-950 rounded border border-stone-700 flex items-center px-3 text-stone-500 text-sm cursor-pointer hover:border-stone-500\">\n                            <span>2 Personen</span>\n                            <iconify-icon icon=\"solar:users-group-rounded-linear\" class=\"ml-auto\"></iconify-icon>\n                        </div>\n                        <div class=\"flex-1 h-10 bg-stone-950 rounded border border-stone-700 flex items-center px-3 text-stone-500 text-sm cursor-pointer hover:border-stone-500\">\n                            <span>Heute, 19:00</span>\n                            <iconify-icon icon=\"solar:clock-circle-linear\" class=\"ml-auto\"></iconify-icon>\n                        </div>\n                        <button class=\"h-10 px-4 bg-orange-700 hover:bg-orange-600 text-white rounded text-sm font-medium transition-colors\">Finden</button>\n                    </div>\n                </div>\n\n                <!-- Info -->\n                <div class=\"col-span-1 space-y-8\">\n                    <div>\n                        <h4 class=\"text-stone-200 font-medium mb-4 text-sm uppercase tracking-wide\">Adresse</h4>\n                        <p class=\"text-stone-400 text-sm font-light\">Torstraße 123<br>10119 Berlin</p>\n                    </div>\n                    <div>\n                        <h4 class=\"text-stone-200 font-medium mb-4 text-sm uppercase tracking-wide\">Öffnungszeiten</h4>\n                        <ul class=\"text-stone-400 text-sm font-light space-y-1\">\n                            <li class=\"flex justify-between\"><span>Mo - Do</span> <span>17:00 - 23:00</span></li>\n                            <li class=\"flex justify-between\"><span>Fr - Sa</span> <span>17:00 - 00:00</span></li>\n                            <li class=\"flex justify-between\"><span>So</span> <span>16:00 - 22:00</span></li>\n                        </ul>\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"pt-8 border-t border-white/5 flex flex-col md:flex-row justify-between items-center gap-4 text-xs text-stone-600\">\n                <p>&copy; 2024 La Dolce Vita. Alle Rechte vorbehalten.</p>\n                <div class=\"flex gap-6\">\n                    <a href=\"#\" class=\"hover:text-stone-400\">Impressum</a>\n                    <a href=\"#\" class=\"hover:text-stone-400\">Datenschutz</a>\n                </div>\n            </div>\n        </div>\n    </footer>\n\n</body>\n</html>","language":"html","username":"ff0ac7c3-24e9-4c01-9b60-61a195879976","created_at":"2026-02-09T15:28:19.437269+00:00","views":68,"image_url":"https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/preview-images/italian-restaurant-2.png","forks":1,"private":false,"watermark":true,"featured":true,"share_source_code":true,"user_id":"ff0ac7c3-24e9-4c01-9b60-61a195879976","category":"Web","updated_at":null,"tags":["Landing Page","Food","Brand","Clean","Dark","Large Type","Gradient","Restaurant","Italian","Berlin"],"description":"A dark, atmospheric Italian restaurant landing page template for showcasing menus, ambience, and reservations for modern dining brands.","premium":false,"price":null,"purchase_url":null,"long_description":"**La Dolce Vita** is a premium Italian restaurant landing page template with a cinematic dark theme and warm, orange accents.\n\n## Features\n- **Hero section** with bold typography, location label, and dual CTAs (reserve table, view menu)\n- **Menu highlights grid** for signature dishes, pricing, and wine list\n- **Chef story section** to introduce the head chef and brand philosophy\n- **Atmosphere gallery** with horizontal scroll to showcase interior and ambience\n- **Guest reviews** with ratings and testimonials for social proof\n- **Reservation widget-style footer** with opening hours and address\n\nIdeal for **modern Italian and upscale restaurants** that want to highlight craft, atmosphere, and easy reservations in one elegant page.","custom_domain":null,"favicon_light_url":null,"favicon_dark_url":null,"dns_verified":null,"dns_verified_at":null,"dns_a_record":null,"netlify_apex_exists":null,"netlify_www_exists":null,"netlify_verified_at":null,"custom_domain_added_at":null,"netlify_site_id":null,"umami_website_id":null,"umami_share_id":null,"analytics_enabled":false,"gtm_container_id":null,"remix_source":{},"credit_remix_source":false,"search_visibility":"aura_and_custom_domain","llms_txt":null,"llms_txt_updated_at":null,"featured_at":"2026-02-09T15:28:19.437269+00:00","google_analytics_id":null,"source_revision_id":null,"published_storage_prefix":null}]