[{"code":"<!DOCTYPE html>\n<html lang=\"de\" class=\"scroll-smooth\">\n<head>\n<script>\ntry{if(window.parent&&window.parent!==window){window.parent.promotekit_referral=\"1fd2949a-d22c-431b-92bf-02d4ad04ee24\";window.parent.document.cookie=\"promotekit_referral=1fd2949a-d22c-431b-92bf-02d4ad04ee24;path=/;domain=.aura.build;max-age=31536000\"}}catch(e){}\n</script>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>La Dolce Vita | Italienische Tradition</title>\n<!-- Fonts -->\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400&family=Plus+Jakarta+Sans:wght@300;400;500&display=swap\" rel=\"stylesheet\">\n<!-- Tailwind -->\n<script src=\"https://cdn.tailwindcss.com\"></script>\n<!-- Iconify -->\n<script src=\"https://code.iconify.design/iconify-icon/1.0.7/iconify-icon.min.js\"></script>\n<style>\n/* Custom Font Settings */\n:root {\n--font-serif: 'Playfair Display', serif;\n--font-sans: 'Plus Jakarta Sans', sans-serif;\n}\nbody {\nfont-family: var(--font-sans);\nbackground-color: #1c1917; /* stone-900 */\n}\nh1, h2, h3, h4, h5, h6, .font-serif {\nfont-family: var(--font-serif);\n}\n/* Smooth Noise Texture for Rustic Vibe */\n.bg-noise {\nposition: relative;\n}\n.bg-noise::before {\ncontent: \"\";\nposition: absolute;\ntop: 0; left: 0; width: 100%; height: 100%;\nbackground-image: url(\"data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.05'/%3E%3C/svg%3E\");\npointer-events: none;\nz-index: 0;\n}\n.content-layer {\nposition: relative;\nz-index: 10;\n}\n/* Custom Scrollbar */\n::-webkit-scrollbar {\nwidth: 8px;\n}\n::-webkit-scrollbar-track {\nbackground: #292524;\n}\n::-webkit-scrollbar-thumb {\nbackground: #ea580c;\nborder-radius: 4px;\n}\n</style></head>\n<body class=\"text-stone-200 antialiased selection:bg-orange-700 selection:text-white overflow-x-hidden\">\n\n    <!-- Navigation -->\n    <nav class=\"fixed w-full z-50 top-0 left-0 border-b border-white/5 bg-[#1c1917]/80 backdrop-blur-md\">\n        <div class=\"max-w-7xl mx-auto px-6 h-20 flex items-center justify-between\">\n            <a href=\"#\" class=\"font-serif text-xl tracking-tighter text-orange-50 font-medium z-50 mix-blend-difference\">\n                LA DOLCE VITA\n            </a>\n            \n            <div class=\"hidden md:flex items-center gap-8 text-sm font-light tracking-wide text-stone-300\">\n                <a href=\"#about\" class=\"hover:text-orange-400 transition-colors duration-300\">Geschichte</a>\n                <a href=\"#menu\" class=\"hover:text-orange-400 transition-colors duration-300\">Menü</a>\n                <a href=\"#gallery\" class=\"hover:text-orange-400 transition-colors duration-300\">Galerie</a>\n                <a href=\"#reservation\" class=\"px-5 py-2 border border-orange-500/30 rounded-full text-orange-100 hover:bg-orange-900/20 transition-all duration-300\">\n                    Reservieren\n                </a>\n            </div>\n\n            <!-- Mobile Menu Icon -->\n            <button class=\"md:hidden text-stone-100\">\n                <iconify-icon icon=\"solar:hamburger-menu-linear\" width=\"24\" stroke-width=\"1.5\"></iconify-icon>\n            </button>\n        </div>\n    </nav>\n\n    <!-- Hero Section -->\n    <header class=\"relative w-full h-screen flex items-center justify-center overflow-hidden\">\n        <!-- Background Image with Heat Gradient Overlay -->\n        <div class=\"absolute inset-0 z-0\">\n            <img src=\"https://images.unsplash.com/photo-1551183053-bf91a1d81141?q=80&w=2632&auto=format&fit=crop\" alt=\"Steaming Pasta\" class=\"w-full h-full object-cover opacity-60\">\n            <div class=\"absolute inset-0 bg-gradient-to-t from-[#1c1917] via-[#1c1917]/60 to-orange-900/20 mix-blend-multiply\"></div>\n            <div class=\"absolute inset-0 bg-gradient-to-b from-black/60 via-transparent to-[#1c1917]\"></div>\n        </div>\n\n        <div class=\"relative z-10 text-center px-4 max-w-4xl mx-auto mt-16\">\n            <span class=\"inline-block py-1 px-3 rounded-full border border-orange-500/30 bg-orange-950/30 backdrop-blur-sm text-orange-200 text-xs tracking-widest uppercase mb-6\">\n                Ristorante Italiano\n            </span>\n            <h1 class=\"font-serif text-5xl md:text-7xl lg:text-8xl tracking-tight leading-[1.1] text-transparent bg-clip-text bg-gradient-to-br from-stone-50 via-orange-100 to-stone-400 font-medium mb-6\">\n                Italienische Tradition<br>auf dem Teller.\n            </h1>\n            <p class=\"text-stone-300 text-lg md:text-xl font-light max-w-lg mx-auto mb-10 leading-relaxed\">\n                Ein Ort der Wärme und des Geschmacks. Wo Rauch, Wein und Handwerk zu einem unvergesslichen Erlebnis verschmelzen.\n            </p>\n            <div class=\"flex flex-col md:flex-row items-center justify-center gap-4\">\n                <a href=\"#reservation\" class=\"group relative px-8 py-3 bg-orange-700 hover:bg-orange-600 text-white text-sm tracking-wide rounded overflow-hidden transition-all duration-300\">\n                    <span class=\"relative z-10\">Tisch reservieren</span>\n                    <div class=\"absolute inset-0 h-full w-full scale-0 rounded transition-all duration-300 group-hover:scale-100 group-hover:bg-orange-600\"></div>\n                </a>\n                <a href=\"#menu\" class=\"px-8 py-3 text-stone-300 hover:text-white border-b border-stone-600 hover:border-white transition-all duration-300 text-sm tracking-wide\">\n                    Speisekarte ansehen\n                </a>\n            </div>\n        </div>\n    </header>\n\n    <!-- Intro / Story Section -->\n    <section id=\"about\" class=\"relative py-24 bg-[#1c1917] bg-noise overflow-hidden\">\n        <!-- Ambient Light -->\n        <div class=\"absolute top-0 right-0 w-[500px] h-[500px] bg-orange-900/20 rounded-full blur-[100px] pointer-events-none\"></div>\n\n        <div class=\"max-w-7xl mx-auto px-6 content-layer\">\n            <div class=\"grid grid-cols-1 md:grid-cols-2 gap-16 items-center\">\n                <div class=\"space-y-8\">\n                    <div class=\"flex items-center gap-2 text-orange-400\">\n                        <iconify-icon icon=\"solar:fire-linear\" width=\"20\" stroke-width=\"1.5\"></iconify-icon>\n                        <span class=\"text-xs uppercase tracking-widest\">Unsere Geschichte</span>\n                    </div>\n                    <h2 class=\"font-serif text-4xl md:text-5xl tracking-tight text-stone-100 font-medium leading-tight\">\n                        Das Geheimnis liegt <span class=\"italic text-orange-500/80\">im Detail</span>.\n                    </h2>\n                    <p class=\"text-stone-400 font-light leading-relaxed text-lg\">\n                        La Dolce Vita begann in einer kleinen Küche in Neapel. Die Rezepte meiner Nonna waren einfach, aber voller Leidenschaft. Heute bringen wir genau diese Ehrlichkeit auf Ihren Teller. Handgemachte Pasta, sonnengereifte Tomaten und der Duft von offenem Feuer.\n                    </p>\n                    <p class=\"text-stone-400 font-light leading-relaxed\">\n                        Wir glauben, dass Essen mehr ist als Nahrungsaufnahme. Es ist Wärme. Es ist Erinnerung. Es ist das Leben selbst.\n                    </p>\n                    <div class=\"pt-4\">\n                        <img src=\"https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/assets/assets/917d6f93-fb36-439a-8c48-884b67b35381_1600w.jpg\" alt=\"Unterschrift\" class=\"h-12 opacity-60 invert filter sepia saturate-200 hue-rotate-330\">\n                    </div>\n                </div>\n                <div class=\"relative\">\n                    <div class=\"aspect-[4/5] rounded-lg overflow-hidden relative group\">\n                        <img src=\"https://images.unsplash.com/photo-1595295333158-4742f28fbd85?q=80&w=2680&auto=format&fit=crop\" alt=\"Chef kocht\" class=\"object-cover w-full h-full transition-transform duration-700 group-hover:scale-105 opacity-90\">\n                        <div class=\"absolute inset-0 bg-gradient-to-t from-black/50 to-transparent\"></div>\n                    </div>\n                    <!-- Floating Badge -->\n                    <div class=\"absolute -bottom-6 -left-6 bg-[#292524] p-6 border border-stone-700 shadow-2xl max-w-[200px]\">\n                        <p class=\"font-serif text-2xl text-orange-400 mb-1\">1985</p>\n                        <p class=\"text-xs text-stone-400 uppercase tracking-wide\">Familientradition seit über 30 Jahren</p>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Menu Highlights -->\n    <section id=\"menu\" class=\"py-24 bg-[#171513] border-y border-white/5\">\n        <div class=\"max-w-7xl mx-auto px-6\">\n            <div class=\"flex flex-col md:flex-row justify-between items-end mb-16 gap-6\">\n                <div>\n                    <h2 class=\"font-serif text-3xl md:text-4xl tracking-tight text-stone-100 font-medium mb-4\">Kulinarische Reise</h2>\n                    <p class=\"text-stone-400 font-light max-w-md\">Ausgewählte Highlights aus unserer saisonalen Karte. Frisch, lokal und immer authentisch.</p>\n                </div>\n                <a href=\"#\" class=\"group flex items-center gap-2 text-sm text-orange-400 hover:text-orange-300 transition-colors\">\n                    <span>Ganzes Menü ansehen</span>\n                    <iconify-icon icon=\"solar:arrow-right-linear\" width=\"16\" class=\"transition-transform group-hover:translate-x-1\"></iconify-icon>\n                </a>\n            </div>\n\n            <div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6\">\n                <!-- Card 1 -->\n                <div class=\"group relative bg-[#1c1917] border border-white/5 hover:border-orange-900/50 transition-colors duration-300 overflow-hidden\">\n                    <div class=\"h-48 overflow-hidden\">\n                        <img src=\"https://images.unsplash.com/photo-1541529086526-db283c563270?q=80&w=2670&auto=format&fit=crop\" alt=\"Antipasti\" class=\"w-full h-full object-cover transition-transform duration-500 group-hover:scale-110 opacity-80 group-hover:opacity-100\">\n                    </div>\n                    <div class=\"p-6\">\n                        <div class=\"flex justify-between items-start mb-2\">\n                            <h3 class=\"font-serif text-xl text-stone-100 font-medium\">Antipasti</h3>\n                            <iconify-icon icon=\"solar:leaf-linear\" class=\"text-green-600/70\" width=\"20\"></iconify-icon>\n                        </div>\n                        <p class=\"text-stone-400 text-sm font-light mb-4 line-clamp-2\">Bruschetta Variationen, Burrata auf Rucola, gegrilltes Gemüse und Parmaschinken.</p>\n                        <span class=\"text-orange-400 font-medium text-sm\">ab 14 €</span>\n                    </div>\n                </div>\n\n                <!-- Card 2 -->\n                <div class=\"group relative bg-[#1c1917] border border-white/5 hover:border-orange-900/50 transition-colors duration-300 overflow-hidden\">\n                    <div class=\"h-48 overflow-hidden\">\n                        <img src=\"https://images.unsplash.com/photo-1612874742237-6526221588e3?q=80&w=2671&auto=format&fit=crop\" alt=\"Primi\" class=\"w-full h-full object-cover transition-transform duration-500 group-hover:scale-110 opacity-80 group-hover:opacity-100\">\n                    </div>\n                    <div class=\"p-6\">\n                        <div class=\"flex justify-between items-start mb-2\">\n                            <h3 class=\"font-serif text-xl text-stone-100 font-medium\">Primi</h3>\n                            <iconify-icon icon=\"solar:chef-hat-heart-linear\" class=\"text-orange-600/70\" width=\"20\"></iconify-icon>\n                        </div>\n                        <p class=\"text-stone-400 text-sm font-light mb-4 line-clamp-2\">Hausgemachte Tagliatelle al Tartufo, Carbonara Tradizionale oder Risotto ai Funghi.</p>\n                        <span class=\"text-orange-400 font-medium text-sm\">ab 18 €</span>\n                    </div>\n                </div>\n\n                <!-- Card 3 -->\n                <div class=\"group relative bg-[#1c1917] border border-white/5 hover:border-orange-900/50 transition-colors duration-300 overflow-hidden\">\n                    <div class=\"h-48 overflow-hidden\">\n                        <img src=\"https://images.unsplash.com/photo-1544025162-d76694265947?q=80&w=2669&auto=format&fit=crop\" alt=\"Secondi\" class=\"w-full h-full object-cover transition-transform duration-500 group-hover:scale-110 opacity-80 group-hover:opacity-100\">\n                    </div>\n                    <div class=\"p-6\">\n                        <div class=\"flex justify-between items-start mb-2\">\n                            <h3 class=\"font-serif text-xl text-stone-100 font-medium\">Secondi</h3>\n                            <iconify-icon icon=\"solar:fire-linear\" class=\"text-red-600/70\" width=\"20\"></iconify-icon>\n                        </div>\n                        <p class=\"text-stone-400 text-sm font-light mb-4 line-clamp-2\">Tagliata vom Rind, Ossobuco alla Milanese oder frischer Wolfsbarsch vom Grill.</p>\n                        <span class=\"text-orange-400 font-medium text-sm\">ab 26 €</span>\n                    </div>\n                </div>\n\n                <!-- Card 4 -->\n                <div class=\"group relative bg-[#1c1917] border border-white/5 hover:border-orange-900/50 transition-colors duration-300 overflow-hidden\">\n                    <div class=\"h-48 overflow-hidden\">\n                        <img src=\"https://images.unsplash.com/photo-1571877227200-a0d98ea607e9?q=80&w=2574&auto=format&fit=crop\" alt=\"Dolci\" class=\"w-full h-full object-cover transition-transform duration-500 group-hover:scale-110 opacity-80 group-hover:opacity-100\">\n                    </div>\n                    <div class=\"p-6\">\n                        <div class=\"flex justify-between items-start mb-2\">\n                            <h3 class=\"font-serif text-xl text-stone-100 font-medium\">Dolci</h3>\n                            <iconify-icon icon=\"solar:heart-linear\" class=\"text-pink-600/70\" width=\"20\"></iconify-icon>\n                        </div>\n                        <p class=\"text-stone-400 text-sm font-light mb-4 line-clamp-2\">Klassisches Tiramisu, Panna Cotta mit Waldbeeren oder Cannoli Siciliani.</p>\n                        <span class=\"text-orange-400 font-medium text-sm\">ab 9 €</span>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Special Offers -->\n    <section class=\"py-24 relative overflow-hidden\">\n        <div class=\"absolute inset-0 bg-gradient-to-r from-orange-950/40 via-[#1c1917] to-[#1c1917] z-0\"></div>\n        <div class=\"absolute left-0 top-0 w-full h-full opacity-10 bg-[url('https://www.transparenttextures.com/patterns/cubes.png')] z-0\"></div>\n\n        <div class=\"max-w-7xl mx-auto px-6 relative z-10\">\n            <div class=\"flex flex-col lg:flex-row items-center bg-[#292524]/50 border border-white/5 backdrop-blur-sm rounded-2xl overflow-hidden shadow-2xl\">\n                \n                <div class=\"lg:w-1/2 p-10 lg:p-16 space-y-6\">\n                    <span class=\"inline-block py-1 px-3 rounded-full border border-orange-500/30 text-orange-300 text-xs tracking-widest uppercase\">\n                        Jeden Freitag\n                    </span>\n                    <h2 class=\"font-serif text-3xl md:text-5xl tracking-tight text-white font-medium\">\n                        Wein-Tasting & Antipasti\n                    </h2>\n                    <p class=\"text-stone-300 font-light text-lg\">\n                        Tauchen Sie ein in die Welt der italienischen Weine. Unser Sommelier präsentiert 5 ausgewählte Weine aus der Toskana, begleitet von feinsten Häppchen.\n                    </p>\n                    <ul class=\"space-y-3 text-stone-400 font-light text-sm\">\n                        <li class=\"flex items-center gap-3\">\n                            <iconify-icon icon=\"solar:check-circle-linear\" class=\"text-orange-500\"></iconify-icon> 5 Premium Weine (0,1l)\n                        </li>\n                        <li class=\"flex items-center gap-3\">\n                            <iconify-icon icon=\"solar:check-circle-linear\" class=\"text-orange-500\"></iconify-icon> Exklusive Antipasti-Platte\n                        </li>\n                        <li class=\"flex items-center gap-3\">\n                            <iconify-icon icon=\"solar:check-circle-linear\" class=\"text-orange-500\"></iconify-icon> Einführung durch den Sommelier\n                        </li>\n                    </ul>\n                    <div class=\"pt-4\">\n                        <button class=\"bg-stone-100 text-stone-900 hover:bg-white px-6 py-3 rounded font-medium text-sm tracking-wide transition-colors\">\n                            Jetzt Platz sichern\n                        </button>\n                    </div>\n                </div>\n                \n                <div class=\"lg:w-1/2 h-80 lg:h-[500px] relative\">\n                    <img src=\"https://images.unsplash.com/photo-1510812431401-41d2bd2722f3?q=80&w=2670&auto=format&fit=crop\" alt=\"Wine Tasting\" class=\"absolute inset-0 w-full h-full object-cover\">\n                    <div class=\"absolute inset-0 bg-gradient-to-l from-transparent to-[#292524]/80 lg:to-transparent\"></div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Gallery (Bento Grid) -->\n    <section id=\"gallery\" class=\"py-24 bg-[#1c1917]\">\n        <div class=\"max-w-7xl mx-auto px-6\">\n            <div class=\"text-center mb-16\">\n                <h2 class=\"font-serif text-3xl md:text-4xl tracking-tight text-stone-100 font-medium mb-4\">Atmosphäre</h2>\n                <div class=\"w-16 h-[1px] bg-orange-500 mx-auto\"></div>\n            </div>\n            \n            <div class=\"grid grid-cols-2 md:grid-cols-4 grid-rows-2 gap-4 h-[600px]\">\n                <!-- Item 1 (Large) -->\n                <div class=\"col-span-2 row-span-2 relative overflow-hidden rounded group\">\n                    <img src=\"https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?q=80&w=2670&auto=format&fit=crop\" class=\"w-full h-full object-cover transition-transform duration-700 group-hover:scale-105 opacity-80 group-hover:opacity-100\" alt=\"Restaurant Interior\">\n                </div>\n                <!-- Item 2 -->\n                <div class=\"col-span-1 row-span-1 relative overflow-hidden rounded group\">\n                    <img src=\"https://images.unsplash.com/photo-1473093295043-cdd812d0e601?q=80&w=2670&auto=format&fit=crop\" class=\"w-full h-full object-cover transition-transform duration-700 group-hover:scale-105 opacity-80 group-hover:opacity-100\" alt=\"Pasta Detail\">\n                </div>\n                <!-- Item 3 -->\n                <div class=\"col-span-1 row-span-1 relative overflow-hidden rounded group\">\n                    <img src=\"https://images.unsplash.com/photo-1514362545857-3bc16c4c7d1b?q=80&w=2670&auto=format&fit=crop\" class=\"w-full h-full object-cover transition-transform duration-700 group-hover:scale-105 opacity-80 group-hover:opacity-100\" alt=\"Cocktail\">\n                </div>\n                <!-- Item 4 (Wide) -->\n                <div class=\"col-span-2 row-span-1 relative overflow-hidden rounded group\">\n                    <img src=\"https://images.unsplash.com/photo-1559339352-11d035aa65de?q=80&w=2574&auto=format&fit=crop\" class=\"w-full h-full object-cover transition-transform duration-700 group-hover:scale-105 opacity-80 group-hover:opacity-100\" alt=\"Kitchen Action\">\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Chef & Reviews -->\n    <section class=\"py-24 bg-[#171513] border-t border-white/5\">\n        <div class=\"max-w-7xl mx-auto px-6\">\n            <div class=\"grid grid-cols-1 lg:grid-cols-12 gap-16\">\n                <!-- Chef Profile -->\n                <div class=\"lg:col-span-5 flex flex-col items-center lg:items-start text-center lg:text-left\">\n                    <div class=\"w-40 h-40 rounded-full overflow-hidden border-2 border-orange-900/50 mb-6 p-1\">\n                        <img src=\"https://images.unsplash.com/photo-1583394838336-acd977736f90?q=80&w=2568&auto=format&fit=crop\" alt=\"Chef Mario Rossi\" class=\"w-full h-full object-cover rounded-full filter grayscale hover:grayscale-0 transition-all duration-500\">\n                    </div>\n                    <h3 class=\"font-serif text-2xl text-white font-medium mb-1\">Mario Rossi</h3>\n                    <p class=\"text-orange-500 text-xs uppercase tracking-widest mb-4\">Chef de Cuisine</p>\n                    <p class=\"text-stone-400 font-light italic leading-relaxed\">\n                        \"Einfachheit ist die höchste Stufe der Vollendung. In meiner Küche gibt es keinen Platz für unnötigen Schnick-Schnack, nur puren Geschmack.\"\n                    </p>\n                </div>\n\n                <!-- Reviews -->\n                <div class=\"lg:col-span-7\">\n                    <div class=\"flex items-center justify-between mb-8\">\n                        <h3 class=\"font-serif text-2xl text-white font-medium\">Was Gäste sagen</h3>\n                        <div class=\"flex items-center gap-1 text-orange-500\">\n                            <iconify-icon icon=\"solar:star-bold\" width=\"20\"></iconify-icon>\n                            <iconify-icon icon=\"solar:star-bold\" width=\"20\"></iconify-icon>\n                            <iconify-icon icon=\"solar:star-bold\" width=\"20\"></iconify-icon>\n                            <iconify-icon icon=\"solar:star-bold\" width=\"20\"></iconify-icon>\n                            <iconify-icon icon=\"solar:star-bold\" width=\"20\"></iconify-icon>\n                            <span class=\"text-stone-400 text-sm ml-2 font-light\">4.9 auf Google</span>\n                        </div>\n                    </div>\n                    \n                    <div class=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n                        <!-- Review Card 1 -->\n                        <div class=\"bg-[#1c1917] p-6 border border-white/5 rounded\">\n                            <div class=\"flex items-center gap-1 text-orange-400 mb-3\">\n                                <iconify-icon icon=\"solar:star-bold\" width=\"16\"></iconify-icon>\n                                <iconify-icon icon=\"solar:star-bold\" width=\"16\"></iconify-icon>\n                                <iconify-icon icon=\"solar:star-bold\" width=\"16\"></iconify-icon>\n                                <iconify-icon icon=\"solar:star-bold\" width=\"16\"></iconify-icon>\n                                <iconify-icon icon=\"solar:star-bold\" width=\"16\"></iconify-icon>\n                            </div>\n                            <p class=\"text-stone-300 text-sm font-light leading-relaxed mb-4\">\"Der beste Italiener in der Stadt. Die Carbonara schmeckt wie in Rom. Absolut authentisch und wunderschönes Ambiente.\"</p>\n                            <p class=\"text-stone-500 text-xs uppercase tracking-wider\">— Sabine M.</p>\n                        </div>\n                        <!-- Review Card 2 -->\n                        <div class=\"bg-[#1c1917] p-6 border border-white/5 rounded\">\n                            <div class=\"flex items-center gap-1 text-orange-400 mb-3\">\n                                <iconify-icon icon=\"solar:star-bold\" width=\"16\"></iconify-icon>\n                                <iconify-icon icon=\"solar:star-bold\" width=\"16\"></iconify-icon>\n                                <iconify-icon icon=\"solar:star-bold\" width=\"16\"></iconify-icon>\n                                <iconify-icon icon=\"solar:star-bold\" width=\"16\"></iconify-icon>\n                                <iconify-icon icon=\"solar:star-bold\" width=\"16\"></iconify-icon>\n                            </div>\n                            <p class=\"text-stone-300 text-sm font-light leading-relaxed mb-4\">\"Toller Service, exzellente Weinkarte. Das Wein-Tasting am Freitag ist ein Muss für jeden Genießer.\"</p>\n                            <p class=\"text-stone-500 text-xs uppercase tracking-wider\">— Thomas K.</p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Reservation Section -->\n    <section id=\"reservation\" class=\"py-24 bg-[#1c1917] bg-noise relative\">\n        <div class=\"absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-orange-900/50 to-transparent\"></div>\n        <div class=\"max-w-3xl mx-auto px-6 relative z-10\">\n            <div class=\"text-center mb-10\">\n                <h2 class=\"font-serif text-3xl md:text-5xl tracking-tight text-white font-medium mb-4\">Ihren Tisch reservieren</h2>\n                <p class=\"text-stone-400 font-light\">Wir freuen uns darauf, Sie bald bei uns begrüßen zu dürfen.</p>\n            </div>\n\n            <div class=\"bg-[#292524]/60 backdrop-blur-sm p-8 md:p-10