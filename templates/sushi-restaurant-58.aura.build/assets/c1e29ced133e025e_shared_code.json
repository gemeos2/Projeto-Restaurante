[{"code":"<!DOCTYPE html>\n<html lang=\"de\" class=\"scroll-smooth\">\n<head>\n<script>\ntry{if(window.parent&&window.parent!==window){window.parent.promotekit_referral=\"1fd2949a-d22c-431b-92bf-02d4ad04ee24\";window.parent.document.cookie=\"promotekit_referral=1fd2949a-d22c-431b-92bf-02d4ad04ee24;path=/;domain=.aura.build;max-age=31536000\"}}catch(e){}\n</script>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>USLU PROJEKTENTWICKLUNG | Exzellenz seit 1996</title>\n<meta name=\"description\" content=\"USLU Projektentwicklung GmbH & Co. KG - German Precision. Mediterranean Vision. Developing visions in Ulm and Izmir since 1996.\">\n<!-- Fonts -->\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,400&family=Inter:wght@200;300;400;500;600&display=swap\" rel=\"stylesheet\">\n<!-- Tailwind CSS -->\n<script src=\"https://cdn.tailwindcss.com\"></script>\n<!-- Iconify -->\n<script src=\"https://cdn.jsdelivr.net/npm/iconify-icon@1.0.7/dist/iconify-icon.min.js\"></script>\n<!-- Tailwind Config for Custom Colors/Fonts -->\n<script>\ntailwind.config = {\ntheme: {\nextend: {\ncolors: {\nuslu: {\ndark: '#121212',\nlight: '#E5E5E1',\nbronze: '#C5A065', // refined bronze\nstone: '#1c1c1c',\nborder: 'rgba(255, 255, 255, 0.1)',\nborderDark: 'rgba(18, 18, 18, 0.1)',\n}\n},\nfontFamily: {\nsans: ['Inter', 'sans-serif'],\nserif: ['Cormorant Garamond', 'serif'],\n},\nletterSpacing: {\ntighter: '-0.04em',\ntight: '-0.02em',\nwidest: '0.15em',\n},\nbackgroundImage: {\n'gradient-radial': 'radial-gradient(var(--tw-gradient-stops))',\n}\n}\n}\n}\n</script>\n<style>\n/* Custom Scrollbar */\n::-webkit-scrollbar {\nwidth: 6px;\n}\n::-webkit-scrollbar-track {\nbackground: #121212;\n}\n::-webkit-scrollbar-thumb {\nbackground: #333;\nborder-radius: 3px;\n}\n::-webkit-scrollbar-thumb:hover {\nbackground: #C5A065;\n}\n/* Selection */\n::selection {\nbackground: #C5A065;\ncolor: #121212;\n}\n/* Smooth Reveal Animation Utilities */\n.reveal-element {\nopacity: 0;\ntransform: translateY(30px);\ntransition: all 1s cubic-bezier(0.16, 1, 0.3, 1);\n}\n.reveal-element.active {\nopacity: 1;\ntransform: translateY(0);\n}\n/* Delay classes */\n.delay-100 { transition-delay: 100ms; }\n.delay-200 { transition-delay: 200ms; }\n.delay-300 { transition-delay: 300ms; }\n.delay-400 { transition-delay: 400ms; }\n.delay-500 { transition-delay: 500ms; }\n/* Grid Lines overlay */\n.grid-lines {\nbackground-size: 100% 100%;\nbackground-image: linear-gradient(to right, rgba(255,255,255,0.03) 1px, transparent 1px),\nlinear-gradient(to bottom, rgba(255,255,255,0.03) 1px, transparent 1px);\nbackground-size: 14.28% 100px; /* approximates a column grid */\npointer-events: none;\n}\n/* Image hover zoom */\n.img-zoom-container {\noverflow: hidden;\n}\n.img-zoom {\ntransition: transform 1.5s cubic-bezier(0.19, 1, 0.22, 1);\n}\n.group:hover .img-zoom {\ntransform: scale(1.05);\n}\n/* Marquee Text */\n@keyframes marquee {\n0% { transform: translateX(0); }\n100% { transform: translateX(-50%); }\n}\n.animate-marquee {\nanimation: marquee 40s linear infinite;\n}\nbody {\nfont-feature-settings: \"ss01\", \"ss02\", \"salt\";\n-webkit-font-smoothing: antialiased;\n}\n</style></head>\n<body class=\"bg-uslu-dark text-uslu-light font-sans overflow-x-hidden relative\">\n\n    <!-- NAVIGATION -->\n    <nav class=\"fixed top-0 w-full z-50 mix-blend-difference text-white px-6 py-6 transition-all duration-300\" id=\"navbar\">\n        <div class=\"max-w-[1920px] mx-auto flex justify-between items-center border-b border-white/20 pb-4\">\n            <a href=\"#\" class=\"group flex flex-col\">\n                <span class=\"text-2xl font-serif tracking-tight font-medium group-hover:text-uslu-bronze transition-colors\">USLU</span>\n                <span class=\"text-[9px] tracking-[0.3em] uppercase opacity-70 mt-0.5\">Projektentwicklung</span>\n            </a>\n\n            <div class=\"hidden md:flex items-center space-x-12 text-xs font-medium tracking-widest uppercase\">\n                <a href=\"#expertise\" class=\"hover:text-uslu-bronze transition-colors relative group\">\n                    Expertise\n                    <span class=\"absolute -bottom-2 left-0 w-0 h-[1px] bg-uslu-bronze transition-all duration-300 group-hover:w-full\"></span>\n                </a>\n                <a href=\"#portfolio\" class=\"hover:text-uslu-bronze transition-colors relative group\">\n                    Portfolio\n                    <span class=\"absolute -bottom-2 left-0 w-0 h-[1px] bg-uslu-bronze transition-all duration-300 group-hover:w-full\"></span>\n                </a>\n                <a href=\"#locations\" class=\"hover:text-uslu-bronze transition-colors relative group\">\n                    Standorte\n                    <span class=\"absolute -bottom-2 left-0 w-0 h-[1px] bg-uslu-bronze transition-all duration-300 group-hover:w-full\"></span>\n                </a>\n            </div>\n\n            <a href=\"#contact\" class=\"hidden md:flex items-center gap-2 border border-white/30 px-5 py-2 rounded-full hover:bg-white hover:text-black transition-all duration-300 text-xs tracking-widest uppercase\">\n                <span>Kontakt</span>\n                <iconify-icon icon=\"solar:arrow-right-linear\"></iconify-icon>\n            </a>\n\n            <!-- Mobile Menu Toggle -->\n            <button class=\"md:hidden text-2xl\" aria-label=\"Menu\">\n                <iconify-icon icon=\"solar:hamburger-menu-linear\"></iconify-icon>\n            </button>\n        </div>\n    </nav>\n\n    <!-- CHAPTER 01: HERO (THE GENESIS) -->\n    <header class=\"relative w-full h-screen flex items-center justify-center overflow-hidden\">\n        <!-- Background Asset -->\n        <div class=\"absolute inset-0 z-0\">\n            <img src=\"https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/assets/assets/20c0faaa-a3f3-491c-a529-c51b3d0da9a8_1600w.jpg\" \n                 alt=\"Architectural Masterpiece\" \n                 class=\"w-full h-full object-cover opacity-60 scale-105 animate-[pulse_10s_ease-in-out_infinite]\">\n            <div class=\"absolute inset-0 bg-gradient-to-t from-uslu-dark via-uslu-dark/40 to-transparent\"></div>\n        </div>\n\n        <!-- Content -->\n        <div class=\"relative z-10 text-center px-4 max-w-5xl mx-auto mt-20\">\n            <div class=\"reveal-element\">\n                <p class=\"text-xs md:text-sm tracking-[0.4em] uppercase text-uslu-bronze mb-6 font-medium\">Established 1996</p>\n                <h1 class=\"font-serif text-5xl md:text-7xl lg:text-9xl tracking-tighter leading-[0.9] text-white mb-8\">\n                    USLU <span class=\"text-transparent bg-clip-text bg-gradient-to-r from-white via-white to-gray-500\">IMMOBILIEN</span>\n                </h1>\n                <p class=\"text-white/70 max-w-2xl mx-auto text-sm md:text-lg font-light leading-relaxed font-sans\">\n                    Ulm & Izmir. Wir entwickeln, vermarkten und verwalten Visionen. <br class=\"hidden md:block\">\n                    Crafting the skyline of tomorrow with German precision.\n                </p>\n            </div>\n            \n            <div class=\"reveal-element delay-300 mt-12 flex flex-col md:flex-row gap-6 justify-center items-center\">\n                <div class=\"flex items-center gap-4 text-xs font-medium tracking-widest text-white/50 uppercase\">\n                    <span class=\"flex items-center gap-2\"><iconify-icon icon=\"solar:map-point-linear\" class=\"text-uslu-bronze\"></iconify-icon> ULM, DE</span>\n                    <span class=\"w-px h-3 bg-white/20\"></span>\n                    <span class=\"flex items-center gap-2\"><iconify-icon icon=\"solar:map-point-linear\" class=\"text-uslu-bronze\"></iconify-icon> IZMIR, TR</span>\n                </div>\n            </div>\n        </div>\n\n        <!-- Scroll Indicator -->\n        <div class=\"absolute bottom-10 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 reveal-element delay-500\">\n            <span class=\"text-[10px] tracking-widest uppercase opacity-50\">Explore</span>\n            <div class=\"w-px h-12 bg-gradient-to-b from-uslu-bronze to-transparent\"></div>\n        </div>\n    </header>\n\n    <!-- CHAPTER 05: THE MANIFESTO (Philosophy) - Moved up for flow -->\n    <section class=\"bg-uslu-light text-uslu-dark py-24 md:py-32 relative overflow-hidden border-t border-b border-black/5\">\n        <div class=\"absolute top-0 left-0 w-full h-full opacity-[0.03] pointer-events-none\" style=\"background-image: url('data:image/svg+xml,...');\">\n            <!-- Subtle noise or pattern could go here -->\n        </div>\n        \n        <div class=\"max-w-[1920px] mx-auto px-6 grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-24 items-start\">\n            <div class=\"lg:col-span-4 reveal-element\">\n                <h2 class=\"text-xs font-bold tracking-[0.2em] uppercase text-uslu-stone mb-4 border-l-2 border-uslu-bronze pl-4\">The Manifesto</h2>\n                <div class=\"text-5xl md:text-7xl font-serif text-uslu-bronze opacity-20 select-none\">25+</div>\n                <p class=\"mt-2 text-sm font-medium uppercase tracking-wider\">Jahre Erfahrung</p>\n            </div>\n            \n            <div class=\"lg:col-span-8 reveal-element delay-200\">\n                <h3 class=\"font-serif text-3xl md:text-5xl lg:text-6xl leading-[1.1] mb-8 text-uslu-dark\">\n                    Wir bauen nicht nur Immobilien.<br>\n                    <span class=\"italic text-uslu-stone/70\">Wir kuratieren Lebensräume.</span>\n                </h3>\n                <p class=\"text-lg md:text-xl font-light text-uslu-stone/80 leading-relaxed max-w-3xl mb-12\">\n                    Über 25 Jahre Erfahrung am Markt. Als inhabergeführtes Familienunternehmen steht USLU für Seriosität, Innovationskraft und grenzüberschreitende Expertise in Deutschland und der Türkei. Wir verbinden schwäbische Gründlichkeit mit mediterraner Vision.\n                </p>\n                \n                <div class=\"grid grid-cols-1 md:grid-cols-3 gap-8 pt-8 border-t border-black/10\">\n                    <div>\n                        <iconify-icon icon=\"solar:shield-check-linear\" class=\"text-3xl text-uslu-bronze mb-3\"></iconify-icon>\n                        <h4 class=\"font-serif text-xl mb-2\">Vertrauen</h4>\n                        <p class=\"text-xs text-uslu-stone/60 leading-relaxed\">Langfristige Partnerschaften durch Transparenz und Handschlagqualität.</p>\n                    </div>\n                    <div>\n                        <iconify-icon icon=\"solar:city-linear\" class=\"text-3xl text-uslu-bronze mb-3\"></iconify-icon>\n                        <h4 class=\"font-serif text-xl mb-2\">Qualität</h4>\n                        <p class=\"text-xs text-uslu-stone/60 leading-relaxed\">Kompromisslose Bauqualität und nachhaltige Materialien.</p>\n                    </div>\n                    <div>\n                        <iconify-icon icon=\"solar:global-linear\" class=\"text-3xl text-uslu-bronze mb-3\"></iconify-icon>\n                        <h4 class=\"font-serif text-xl mb-2\">Netzwerk</h4>\n                        <p class=\"text-xs text-uslu-stone/60 leading-relaxed\">Starke Präsenz in den Wachstumsmärkten Ulm und Izmir.</p>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- CHAPTER 03: THE CRAFT (Expertise) -->\n    <section id=\"expertise\" class=\"bg-uslu-dark text-white py-0 border-b border-white/10 relative\">\n        <!-- Decorative Grid Lines -->\n        <div class=\"absolute inset-0 grid-lines opacity-20\"></div>\n\n        <div class=\"max-w-[1920px] mx-auto grid grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-white/10 border-l border-r border-white/10\">\n            \n            <!-- Service 1 -->\n            <div class=\"group relative p-10 md:p-16 hover:bg-white/5 transition-colors duration-500 reveal-element border-b md:border-b-0 border-white/10\">\n                <div class=\"absolute top-6 right-6 opacity-0 group-hover:opacity-100 transition-opacity duration-500\">\n                    <iconify-icon icon=\"solar:arrow-right-up-linear\" class=\"text-2xl text-uslu-bronze\"></iconify-icon>\n                </div>\n                <div class=\"w-12 h-12 rounded-full border border-white/20 flex items-center justify-center mb-12 text-uslu-bronze group-hover:bg-uslu-bronze group-hover:text-black transition-all duration-300\">\n                    <iconify-icon icon=\"solar:ruler-pen-linear\" class=\"text-xl\"></iconify-icon>\n                </div>\n                <h3 class=\"font-serif text-3xl mb-4\">Projektentwicklung</h3>\n                <p class=\"text-white/60 text-sm leading-relaxed mb-8\">\n                    Von der ersten Vision bis zur Baugenehmigung. Wir schaffen nachhaltige Immobilienwerte durch intelligente Planung und effiziente Prozesse.\n                </p>\n                <ul class=\"space-y-3\">\n                    <li class=\"flex items-center gap-3 text-xs tracking-wide text-white/40 group-hover:text-white/80 transition-colors\">\n                        <span class=\"w-1 h-1 bg-uslu-bronze rounded-full\"></span> Standortanalyse\n                    </li>\n                    <li class=\"flex items-center gap-3 text-xs tracking-wide text-white/40 group-hover:text-white/80 transition-colors\">\n                        <span class=\"w-1 h-1 bg-uslu-bronze rounded-full\"></span> Baurechtschaffung\n                    </li>\n                    <li class=\"flex items-center gap-3 text-xs tracking-wide text-white/40 group-hover:text-white/80 transition-colors\">\n                        <span class=\"w-1 h-1 bg-uslu-bronze rounded-full\"></span> Architekturkonzeption\n                    </li>\n                </ul>\n            </div>\n\n            <!-- Service 2 -->\n            <div class=\"group relative p-10 md:p-16 hover:bg-white/5 transition-colors duration-500 reveal-element delay-100 border-b md:border-b-0 border-white/10\">\n                <div class=\"absolute top-6 right-6 opacity-0 group-hover:opacity-100 transition-opacity duration-500\">\n                    <iconify-icon icon=\"solar:arrow-right-up-linear\" class=\"text-2xl text-uslu-bronze\"></iconify-icon>\n                </div>\n                <div class=\"w-12 h-12 rounded-full border border-white/20 flex items-center justify-center mb-12 text-uslu-bronze group-hover:bg-uslu-bronze group-hover:text-black transition-all duration-300\">\n                    <iconify-icon icon=\"solar:chart-square-linear\" class=\"text-xl\"></iconify-icon>\n                </div>\n                <h3 class=\"font-serif text-3xl mb-4\">Vermarktung</h3>\n                <p class=\"text-white/60 text-sm leading-relaxed mb-8\">\n                    Professionelle Vermietung und Verkauf von Wohn- und Gewerbeobjekten. Wir platzieren Ihre Immobilie gewinnbringend am Markt.\n                </p>\n                <ul class=\"space-y-3\">\n                    <li class=\"flex items-center gap-3 text-xs tracking-wide text-white/40 group-hover:text-white/80 transition-colors\">\n                        <span class=\"w-1 h-1 bg-uslu-bronze rounded-full\"></span> Vertriebsstrategie\n                    </li>\n                    <li class=\"flex items-center gap-3 text-xs tracking-wide text-white/40 group-hover:text-white/80 transition-colors\">\n                        <span class=\"w-1 h-1 bg-uslu-bronze rounded-full\"></span> Exposé Erstellung\n                    </li>\n                    <li class=\"flex items-center gap-3 text-xs tracking-wide text-white/40 group-hover:text-white/80 transition-colors\">\n                        <span class=\"w-1 h-1 bg-uslu-bronze rounded-full\"></span> Vertragsmanagement\n                    </li>\n                </ul>\n            </div>\n\n            <!-- Service 3 -->\n            <div class=\"group relative p-10 md:p-16 hover:bg-white/5 transition-colors duration-500 reveal-element delay-200\">\n                <div class=\"absolute top-6 right-6 opacity-0 group-hover:opacity-100 transition-opacity duration-500\">\n                    <iconify-icon icon=\"solar:arrow-right-up-linear\" class=\"text-2xl text-uslu-bronze\"></iconify-icon>\n                </div>\n                <div class=\"w-12 h-12 rounded-full border border-white/20 flex items-center justify-center mb-12 text-uslu-bronze group-hover:bg-uslu-bronze group-hover:text-black transition-all duration-300\">\n                    <iconify-icon icon=\"solar:key-linear\" class=\"text-xl\"></iconify-icon>\n                </div>\n                <h3 class=\"font-serif text-3xl mb-4\">Verwaltung</h3>\n                <p class=\"text-white/60 text-sm leading-relaxed mb-8\">\n                    Ganzheitliches Property Management für Werterhalt und Rendite. Wir kümmern uns um die kaufmännische und technische Betreuung.\n                </p>\n                <ul class=\"space-y-3\">\n                    <li class=\"flex items-center gap-3 text-xs tracking-wide text-white/40 group-hover:text-white/80 transition-colors\">\n                        <span class=\"w-1 h-1 bg-uslu-bronze rounded-full\"></span> Facility Management\n                    </li>\n                    <li class=\"flex items-center gap-3 text-xs tracking-wide text-white/40 group-hover:text-white/80 transition-colors\">\n                        <span class=\"w-1 h-1 bg-uslu-bronze rounded-full\"></span> Mietverwaltung\n                    </li>\n                    <li class=\"flex items-center gap-3 text-xs tracking-wide text-white/40 group-hover:text-white/80 transition-colors\">\n                        <span class=\"w-1 h-1 bg-uslu-bronze rounded-full\"></span> Instandhaltung\n                    </li>\n                </ul>\n            </div>\n\n        </div>\n    </section>\n\n    <!-- CHAPTER 02: THE PORTFOLIO (Projects) -->\n    <section id=\"portfolio\" class=\"bg-uslu-stone py-24 border-b border-white/5\">\n        <div class=\"max-w-[1920px] mx-auto px-6 mb-16 flex flex-col md:flex-row justify-between items-end reveal-element\">\n            <div>\n                <span class=\"text-uslu-bronze text-xs font-bold tracking-[0.2em] uppercase\">Ausgewählte Projekte</span>\n                <h2 class=\"text-4xl md:text-6xl font-serif text-white mt-4\">Meilensteine</h2>\n            </div>\n            <a href=\"#\" class=\"hidden md:inline-flex items-center gap-2 text-white/50 hover:text-white transition-colors text-xs uppercase tracking-widest mt-6 md:mt-0\">\n                Alle Projekte ansehen\n                <iconify-icon icon=\"solar:arrow-right-linear\"></iconify-icon>\n            </a>\n        </div>\n\n        <!-- Horizontal Scroll Container -->\n        <div class=\"overflow-x-auto pb-12 hide-scrollbar pl-6 md:pl-[max(24px,calc((100vw-1920px)/2+24px))]\">\n            <div class=\"flex gap-8 w-max pr-6\">\n                \n                <!-- Project 1 -->\n                <article class=\"group relative w-[85vw] md:w-[600px] h-[500px] bg-uslu-dark border border-white/10 rounded-sm overflow-hidden reveal-element\">\n                    <div class=\"absolute inset-0 img-zoom-container\">\n                        <img src=\"https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/assets/assets/1dfd9627-0dcf-4311-aae8-3b1a9466f63c_1600w.webp\" alt=\"Residential\" class=\"w-full h-full object-cover opacity-80 group-hover:opacity-100 img-zoom transition-all duration-700\">\n                    </div>\n                    <div class=\"absolute inset-0 bg-gradient-to-t from-black via-transparent to-transparent opacity-90\"></div>\n                    \n                    <div class=\"absolute top-6 left-6 flex gap-2\">\n                        <span class=\"bg-white/10 backdrop-blur-md px-3 py-1 text-[10px] uppercase tracking-widest text-white border border-white/10\">Wohnanlagen</span>\n                    </div>\n\n                    <div class=\"absolute bottom-0 left-0 w-full p-8 border-t border-white/10 bg-black/40 backdrop-blur-sm\">\n                        <div class=\"flex justify-between items-end\">\n                            <div>\n                                <h3 class=\"text-2xl font-serif text-white mb-1\">Donau Residenz</h3>\n                                <p class=\"text-xs text-uslu-bronze uppercase tracking-widest\">Ulm, Deutschland</p>\n                            </div>\n                            <div class=\"text-right\">\n                                <p class=\"text-[10px] text-white/50 uppercase tracking-widest mb-1\">Status</p>\n                                <p class=\"text-xs text-white font-medium\">Realisiert</p>\n                            </div>\n                        </div>\n                    </div>\n                </article>\n\n                <!-- Project 2 -->\n                <article class=\"group relative w-[85vw] md:w-[600px] h-[500px] bg-uslu-dark border border-white/10 rounded-sm overflow-hidden reveal-element delay-100\">\n                    <div class=\"absolute inset-0 img-zoom-container\">\n                        <img src=\"https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/assets/assets/7f78131e-65e9-49b2-aa1f-ccc33e28df9f_1600w.webp\" alt=\"Commercial\" class=\"w-full h-full object-cover opacity-80 group-hover:opacity-100 img-zoom transition-all duration-700\">\n                    </div>\n                    <div class=\"absolute inset-0 bg-gradient-to-t from-black via-transparent to-transparent opacity-90\"></div>\n                    \n                    <div class=\"absolute top-6 left-6 flex gap-2\">\n                        <span class