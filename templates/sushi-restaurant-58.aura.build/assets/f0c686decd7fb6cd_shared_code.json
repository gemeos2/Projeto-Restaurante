); }\n.japanese { font-family: var(--font-japanese); }\n::selection {\nbackground-color: var(--color-gold);\ncolor: var(--color-black);\n}\n/* Grain Overlay */\n.grain {\nposition: fixed;\ntop: 0; left: 0; width: 100%; height: 100%;\nbackground-image: url(\"data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E\");\nopacity: 0.04;\npointer-events: none;\nz-index: 50;\n}\n/* Navigation */\n.nav-glass {\nbackground: rgba(10, 10, 10, 0.9);\nbackdrop-filter: blur(12px);\nborder-bottom: 1px solid rgba(255,255,255,0.05);\n}\n/* Map Grayscale */\n.map-grayscale {\nfilter: grayscale(100%) invert(92%) contrast(83%);\ntransition: filter 0.5s ease;\n}\n.map-grayscale:hover {\nfilter: grayscale(0%) invert(0%);\n}\n/* Background Kanji Scroll Effect */\n.background-kanji {\nposition: absolute;\ntop: 0;\nright: 20px;\nwidth: fit-content;\noverflow: hidden;\npointer-events: none;\nz-index: 0;\n}\n.background-kanji__text {\nfont-family: var(--font-japanese);\nfont-size: 4rem;\ncolor: var(--color-gold);\nopacity: 0.08;\nwriting-mode: vertical-rl;\ntext-orientation: mixed;\nwhite-space: nowrap;\n}\n/* Horizontal Scroll Section */\n.menu-scroll-container {\ndisplay: flex;\ngap: 2rem;\npadding-left: max(2rem, calc((100vw - 1280px) / 2 + 2rem));\npadding-right: 2rem;\noverflow-x: auto;\nscrollbar-width: none; /* Firefox */\n-ms-overflow-style: none; /* IE/Edge */\n}\n.menu-scroll-container::-webkit-scrollbar { display: none; }\n/* Utilities */\n.text-gold { color: var(--color-gold); }\n.border-gold { border-color: var(--color-gold); }\n.bg-gold { background-color: var(--color-gold); }\n.reveal-up { opacity: 0; transform: translateY(30px); }\n.reveal-scale { opacity: 0; transform: scale(0.95); }\n</style></head>\n<body class=\"antialiased\">\n\n    <!-- Loading Screen -->\n    <div id=\"loader\" class=\"fixed inset-0 bg-[#0a0a0a] z-[100] flex flex-col items-center justify-center transition-opacity duration-700\">\n        <div class=\"japanese text-6xl text-gold mb-4\">乾杯</div>\n        <div class=\"h-[1px] w-24 bg-white/20 overflow-hidden\">\n            <div id=\"loader-bar\" class=\"h-full w-0 bg-gold transition-all duration-1000 ease-out\"></div>\n        </div>\n    </div>\n\n    <!-- Grain & Noise -->\n    <div class=\"grain\"></div>\n\n    <!-- Navigation -->\n    <nav id=\"navbar\" class=\"fixed top-0 left-0 w-full z-40 transition-all duration-500 nav-glass py-5\">\n        <div class=\"max-w-7xl mx-auto px-6 flex justify-between items-center\">\n            <a href=\"#\" class=\"flex items-center gap-3 group\">\n                <span class=\"japanese text-2xl text-gold group-hover:text-white transition-colors\">乾杯</span>\n                <div class=\"flex flex-col\">\n                    <span class=\"font-serif uppercase text-sm tracking-[0.2em] text-white\">Kampai</span>\n                    <span class=\"text-[9px] uppercase tracking-[0.3em] text-white/40\">Hamburg</span>\n                </div>\n            </a>\n\n            <!-- Desktop Menu -->\n            <ul class=\"hidden md:flex items-center gap-12\">\n                <li><a href=\"#philosophy\" class=\"text-xs uppercase tracking-[0.2em] text-white/60 hover:text-gold transition-colors\">Philosophie</a></li>\n                <li><a href=\"#specials\" class=\"text-xs uppercase tracking-[0.2em] text-white/60 hover:text-gold transition-colors\">Specials</a></li>\n                <li><a href=\"#menu\" class=\"text-xs uppercase tracking-[0.2em] text-white/60 hover:text-gold transition-colors\">Karte</a></li>\n                <li><a href=\"#info\" class=\"text-xs uppercase tracking-[0.2em] text-white/60 hover:text-gold transition-colors\">Info</a></li>\n            </ul>\n\n            <a href=\"#info\" class=\"hidden md:block px-6 py-2 border border-gold/30 text-xs uppercase tracking-[0.2em] text-gold hover:bg-gold hover:text-black transition-all duration-500\">\n                Reserve\n            </a>\n\n            <!-- Mobile Menu Icon -->\n            <button class=\"md:hidden text-gold\">\n                <iconify-icon icon=\"solar:hamburger-menu-linear\" width=\"24\"></iconify-icon>\n            </button>\n        </div>\n    </nav>\n\n    <!-- Content Wrapper -->\n    <div class=\"relative\">\n        \n        <!-- Background Kanji -->\n        <div class=\"hidden lg:block background-kanji h-full\">\n            <div class=\"background-kanji__text\">寿司の芸術鮮度匠心技美味極上職人魂伝統革新四季折々海の恵み一期一会</div>\n        </div>\n\n        <!-- Hero Section -->\n        <section id=\"home\" class=\"relative h-screen w-full overflow-hidden flex items-center justify-center\">\n            <div class=\"absolute inset-0 z-0\">\n                <!-- Parallax Image -->\n                <img src=\"https://images.unsplash.com/photo-1553621042-f6e147245754?q=80&w=2525&auto=format&fit=crop\" \n                     alt=\"Sushi Counter\" \n                     class=\"w-full h-[120%] object-cover opacity-50 parallax-img\">\n                <div class=\"absolute inset-0 bg-gradient-to-b from-[#0a0a0a]/80 via-[#0a0a0a]/20 to-[#0a0a0a]\"></div>\n            </div>\n\n            <div class=\"relative z-10 text-center px-6\">\n                <div class=\"japanese text-[15vw] md:text-[8rem] text-gold/90 leading-none mb-2 opacity-0 reveal-up\">乾杯</div>\n                <h1 class=\"text-4xl md:text-6xl font-light tracking-tight text-cream mb-6 opacity-0 reveal-up delay-100\">\n                    Kampai Sushi Bar\n                </h1>\n                <div class=\"flex items-center justify-center gap-4 opacity-0 reveal-up delay-200\">\n                    <div class=\"h-[1px] w-12 bg-gold/50\"></div>\n                    <p class=\"text-xs md:text-sm tracking-[0.3em] uppercase text-white/60\">Inh. Hiroshi Sumikawa</p>\n                    <div class=\"h-[1px] w-12 bg-gold/50\"></div>\n                </div>\n            </div>\n\n            <div class=\"absolute bottom-12 left-1/2 -translate-x-1/2 flex flex-col items-center gap-4 opacity-0 reveal-up delay-500\">\n                <span class=\"text-[9px] uppercase tracking-[0.3em] text-white/40\">Scroll</span>\n                <div class=\"w-[1px] h-16 bg-gradient-to-b from-gold to-transparent\"></div>\n            </div>\n        </section>\n\n        <!-- Philosophy Section -->\n        <section id=\"philosophy\" class=\"relative py-24 md:py-32 px-6 bg-[#0a0a0a]\">\n            <div class=\"max-w-6xl mx-auto grid md:grid-cols-2 gap-16 items-center\">\n                <div class=\"relative aspect-[3/4] md:aspect-[4/5] reveal-up\">\n                    <div class=\"absolute -top-4 -left-4 w-full h-full border border-gold/20 z-0\"></div>\n                    <img src=\"https://images.unsplash.com/photo-1611143669185-af224c5e3252?q=80&w=1632&auto=format&fit=crop\" alt=\"Chef Craft\" class=\"relative z-10 w-full h-full object-cover grayscale hover:grayscale-0 transition-all duration-1000\">\n                </div>\n                <div class=\"reveal-up\">\n                    <span class=\"text-xs uppercase tracking-[0.3em] text-gold mb-4 block flex items-center gap-2\">\n                        <span class=\"w-8 h-[1px] bg-gold\"></span> Tradition\n                    </span>\n                    <h2 class=\"text-3xl md:text-5xl font-light leading-tight text-white mb-8\">\n                        Authentic Japanese <br>\n                        <span class=\"serif italic text-gold\">Craftsmanship</span>\n                    </h2>\n                    <p class=\"text-white/60 font-light leading-relaxed mb-8\">\n                        Willkommen bei Kampai. Unter der Leitung von Hiroshi Sumikawa bringen wir die Essenz der japanischen Sushi-Kunst in den Hamburger Berg. Jedes Stück wird mit höchster Präzision und Hingabe zubereitet.\n                    </p>\n                    <div class=\"flex items-center gap-4\">\n                        <span class=\"japanese text-2xl text-gold\">澄川 博</span>\n                        <span class=\"text-xs uppercase tracking-widest text-white/40\">Hiroshi Sumikawa</span>\n                    </div>\n                </div>\n            </div>\n        </section>\n\n        <!-- Specials Horizontal Scroll -->\n        <section id=\"specials\" class=\"relative py-24 bg-[#0f0f0f] border-t border-white/5 overflow-hidden\">\n            <div class=\"max-w-7xl mx-auto px-6 mb-12 flex justify-between items-end reveal-up\">\n                <div>\n                    <span class=\"text-xs uppercase tracking-[0.3em] text-gold mb-2 block\">Empfehlung</span>\n                    <h2 class=\"text-3xl md:text-4xl font-light text-white\">Kampai <span class=\"serif italic text-white/50\">Specials</span></h2>\n                </div>\n                <div class=\"hidden md:flex gap-2 text-white/40\">\n                    <iconify-icon icon=\"solar:arrow-left-linear\" width=\"24\"></iconify-icon>\n                    <iconify-icon icon=\"solar:arrow-right-linear\" width=\"24\"></iconify-icon>\n                </div>\n            </div>\n\n            <!-- Horizontal Scroll Container -->\n            <div class=\"menu-scroll-container pb-8 reveal-up\">\n                \n                <!-- Box 1 -->\n                <div class=\"flex-none w-[320px] md:w-[400px] group cursor-pointer\">\n                    <div class=\"aspect-[4/3] bg-[#1a1a1a] overflow-hidden mb-6 relative\">\n                        <img src=\"https://images.unsplash.com/photo-1579871494447-9811cf80d66c?q=80&w=1470&auto=format&fit=crop\" class=\"w-full h-full object-cover opacity-80 group-hover:opacity-100 group-hover:scale-105 transition-all duration-700\">\n                        <div class=\"absolute top-4 right-4 bg-black/80 backdrop-blur text-gold px-3 py-1 text-sm tracking-widest font-serif\">30€</div>\n                    </div>\n                    <h3 class=\"text-xl font-light text-white mb-2 group-hover:text-gold transition-colors\">Kampai Special Box</h3>\n                    <ul class=\"text-sm text-white/50 font-light space-y-1\">\n                        <li>1 x Vorspeise (Überraschung)</li>\n                        <li>1 x California Roll (6 Stück)</li>\n                        <li>6 x Nigiri (Überraschung)</li>\n                    </ul>\n                </div>\n\n                <!-- Box 2 -->\n                <div class=\"flex-none w-[320px] md:w-[400px] group cursor-pointer\">\n                    <div class=\"aspect-[4/3] bg-[#1a1a1a] overflow-hidden mb-6 relative\">\n                        <img src=\"https://images.unsplash.com/photo-1558985250-27a406d64cb3?q=80&w=1470&auto=format&fit=crop\" class=\"w-full h-full object-cover opacity-80 group-hover:opacity-100 group-hover:scale-105 transition-all duration-700\">\n                        <div class=\"absolute top-4 right-4 bg-black/80 backdrop-blur text-gold px-3 py-1 text-sm tracking-widest font-serif\">25€</div>\n                    </div>\n                    <h3 class=\"text-xl font-light text-white mb-2 group-hover:text-gold transition-colors\">Kampai Veggie Box</h3>\n                    <ul class=\"text-sm text-white/50 font-light space-y-1\">\n                        <li>1 x Vorspeise (Überraschung)</li>\n                        <li>2 x Veggie Rolls (Überraschung, 12 Stück)</li>\n                        <li>4 x Veggie Nigiri (Überraschung)</li>\n                    </ul>\n                </div>\n\n                <!-- Highlight 3 -->\n                <div class=\"flex-none w-[320px] md:w-[400px] group cursor-pointer\">\n                    <div class=\"aspect-[4/3] bg-[#1a1a1a] overflow-hidden mb-6 relative\">\n                        <img src=\"https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/assets/assets/917d6f93-fb36-439a-8c48-884b67b35381_1600w.jpg\" class=\"w-full h-full object-cover opacity-80 group-hover:opacity-100 group-hover:scale-105 transition-all duration-700\">\n                        <div class=\"absolute top-4 right-4 bg-black/80 backdrop-blur text-gold px-3 py-1 text-sm tracking-widest font-serif\">45€</div>\n                    </div>\n                    <h3 class=\"text-xl font-light text-white mb-2 group-hover:text-gold transition-colors\">Sashimi Moriawase</h3>\n                    <p class=\"text-sm text-white/50 font-light\">\n                        Premium assortment of raw fish, 12 pieces. Chef's daily selection.\n                    </p>\n                </div>\n            </div>\n        </section>\n\n        <!-- Full Menu Section -->\n        <section id=\"menu\" class=\"relative py-24 px-6 bg-[#0a0a0a]\">\n            <div class=\"max-w-5xl mx-auto\">\n                <div class=\"text-center mb-20 reveal-up\">\n                    <span class=\"japanese text-4xl text-gold/20 mb-2 block\">品書き</span>\n                    <h2 class=\"text-3xl md:text-5xl font-light text-white tracking-tight\">Speisekarte</h2>\n                </div>\n\n                <!-- Grid Layout for Menu Categories -->\n                <div class=\"grid md:grid-cols-2 gap-x-20 gap-y-16\">\n                    \n                    <!-- Vorspeisen -->\n                    <div class=\"reveal-up\">\n                        <div class=\"flex items-center gap-4 mb-8\">\n                            <h3 class=\"text-xl font-serif italic text-gold\">Vorspeisen</h3>\n                            <div class=\"h-[1px] flex-grow bg-white/10\"></div>\n                        </div>\n                        <ul class=\"space-y-6\">\n                            <li class=\"flex justify-between items-baseline group\">\n                                <div>\n                                    <span class=\"text-white group-hover:text-gold transition-colors font-light\">Seetang Salat</span>\n                                </div>\n                          