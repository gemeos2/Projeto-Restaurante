                             <span class=\"text-white/40 font-light text-sm\">5€</span>\n                            </li>\n                            <li class=\"flex justify-between items-baseline group\">\n                                <div>\n                                    <span class=\"text-white group-hover:text-gold transition-colors font-light\">Spinat mit Sesamsauce</span>\n                                </div>\n                                <span class=\"text-white/40 font-light text-sm\">5€</span>\n                            </li>\n                            <li class=\"flex justify-between items-baseline group\">\n                                <div>\n                                    <span class=\"text-white group-hover:text-gold transition-colors font-light\">Blanchierter Lachs</span>\n                                    <span class=\"block text-xs text-white/30\">mit Porree</span>\n                                </div>\n                                <span class=\"text-white/40 font-light text-sm\">5€</span>\n                            </li>\n                        </ul>\n                    </div>\n\n                    <!-- Nigiri -->\n                    <div class=\"reveal-up\">\n                        <div class=\"flex items-center gap-4 mb-8\">\n                            <h3 class=\"text-xl font-serif italic text-gold\">Nigiri <span class=\"text-xs font-sans not-italic text-white/30 ml-2 tracking-widest\">(2 Stück)</span></h3>\n                            <div class=\"h-[1px] flex-grow bg-white/10\"></div>\n                        </div>\n                        <ul class=\"grid grid-cols-1 gap-y-4\">\n                            <!-- Helper for item rows -->\n                            <li class=\"flex justify-between items-baseline border-b border-dashed border-white/5 pb-1\"><span class=\"text-white font-light\">Thunfisch</span><span class=\"text-gold text-sm\">8.5€</span></li>\n                            <li class=\"flex justify-between items-baseline border-b border-dashed border-white/5 pb-1\"><span class=\"text-white font-light\">Lachs</span><span class=\"text-gold text-sm\">8€</span></li>\n                            <li class=\"flex justify-between items-baseline border-b border-dashed border-white/5 pb-1\"><span class=\"text-white font-light\">Yellowtail</span><span class=\"text-gold text-sm\">9€</span></li>\n                            <li class=\"flex justify-between items-baseline border-b border-dashed border-white/5 pb-1\"><span class=\"text-white font-light\">Wolfsbarsch</span><span class=\"text-gold text-sm\">7.5€</span></li>\n                            <li class=\"flex justify-between items-baseline border-b border-dashed border-white/5 pb-1\"><span class=\"text-white font-light\">Makrele</span><span class=\"text-gold text-sm\">7.5€</span></li>\n                            <li class=\"flex justify-between items-baseline border-b border-dashed border-white/5 pb-1\"><span class=\"text-white font-light\">Spicy Thunfisch</span><span class=\"text-gold text-sm\">7.5€</span></li>\n                            <li class=\"flex justify-between items-baseline border-b border-dashed border-white/5 pb-1\"><span class=\"text-white font-light\">Flambierter Lachs</span><span class=\"text-gold text-sm\">8.5€</span></li>\n                            <li class=\"flex justify-between items-baseline border-b border-dashed border-white/5 pb-1\"><span class=\"text-white font-light\">Flambierte Scholle</span><span class=\"text-gold text-sm\">7.5€</span></li>\n                            <li class=\"flex justify-between items-baseline border-b border-dashed border-white/5 pb-1\"><span class=\"text-white font-light\">Gebratener Aal</span><span class=\"text-gold text-sm\">9€</span></li>\n                            <li class=\"flex justify-between items-baseline border-b border-dashed border-white/5 pb-1\"><span class=\"text-white font-light\">Jakobsmuschel</span><span class=\"text-gold text-sm\">9€</span></li>\n                            <li class=\"flex justify-between items-baseline border-b border-dashed border-white/5 pb-1\"><span class=\"text-white font-light\">Roter Kaviar (Lachs)</span><span class=\"text-gold text-sm\">9€</span></li>\n                        </ul>\n                    </div>\n\n                    <!-- Maki -->\n                    <div class=\"reveal-up\">\n                        <div class=\"flex items-center gap-4 mb-8\">\n                            <h3 class=\"text-xl font-serif italic text-gold\">Maki <span class=\"text-xs font-sans not-italic text-white/30 ml-2 tracking-widest\">(6 Stück)</span></h3>\n                            <div class=\"h-[1px] flex-grow bg-white/10\"></div>\n                        </div>\n                        <ul class=\"grid grid-cols-1 gap-y-4\">\n                            <li class=\"flex justify-between items-baseline border-b border-dashed border-white/5 pb-1\"><span class=\"text-white font-light\">Thunfisch</span><span class=\"text-gold text-sm\">8€</span></li>\n                            <li class=\"flex justify-between items-baseline border-b border-dashed border-white/5 pb-1\"><span class=\"text-white font-light\">Lachs</span><span class=\"text-gold text-sm\">7.5€</span></li>\n                            <li class=\"flex justify-between items-baseline border-b border-dashed border-white/5 pb-1\"><span class=\"text-white font-light\">Surimi</span><span class=\"text-gold text-sm\">6.5€</span></li>\n                            <li class=\"flex justify-between items-baseline border-b border-dashed border-white/5 pb-1\"><span class=\"text-white font-light\">Gebratener Aal</span><span class=\"text-gold text-sm\">8.5€</span></li>\n                            <li class=\"flex justify-between items-baseline border-b border-dashed border-white/5 pb-1\"><span class=\"text-white font-light\">Crispy Lachs</span><span class=\"text-gold text-sm\">8.5€</span></li>\n                            <li class=\"flex justify-between items-baseline border-b border-dashed border-white/5 pb-1\"><span class=\"text-white font-light\">Spicy Thunfisch</span><span class=\"text-gold text-sm\">8€</span></li>\n                            <li class=\"flex justify-between items-baseline border-b border-dashed border-white/5 pb-1\"><span class=\"text-white font-light\">California (Surimi)</span><span class=\"text-gold text-sm\">7.5€</span></li>\n                            <li class=\"flex justify-between items-baseline border-b border-dashed border-white/5 pb-1\"><span class=\"text-white font-light\">California (Thunfisch)</span><span class=\"text-gold text-sm\">9€</span></li>\n                            <li class=\"flex justify-between items-baseline border-b border-dashed border-white/5 pb-1\"><span class=\"text-white font-light\">California (Lachs)</span><span class=\"text-gold text-sm\">8.5€</span></li>\n                            <li class=\"flex justify-between items-baseline border-b border-dashed border-white/5 pb-1\"><span class=\"text-white font-light\">Avocado</span><span class=\"text-gold text-sm\">6€</span></li>\n                        </ul>\n                    </div>\n\n                    <!-- Getränke -->\n                    <div class=\"reveal-up\">\n                        <div class=\"flex items-center gap-4 mb-8\">\n                            <h3 class=\"text-xl font-serif italic text-gold\">Getränke</h3>\n                            <div class=\"h-[1px] flex-grow bg-white/10\"></div>\n                        </div>\n                        <div class=\"space-y-8\">\n                            <div>\n                                <h4 class=\"text-xs uppercase tracking-widest text-white/40 mb-3\">Alkoholfrei</h4>\n                                <ul class=\"space-y-2\">\n                                    <li class=\"flex justify-between text-sm\"><span class=\"text-white/80 font-light\">Mineralwasser / Still (0.25l)</span> <span class=\"text-gold\">3.5€</span></li>\n                                    <li class=\"flex justify-between text-sm\"><span class=\"text-white/80 font-light\">Coca Cola light (0.2l)</span> <span class=\"text-gold\">3.5€</span></li>\n                                    <li class=\"flex justify-between text-sm\"><span class=\"text-white/80 font-light\">Jap. Grüner Tee / Jasmintee</span> <span class=\"text-gold\">4€</span></li>\n                                </ul>\n                            </div>\n                            <div>\n                                <h4 class=\"text-xs uppercase tracking-widest text-white/40 mb-3\">Alkoholisch</h4>\n                                <ul class=\"space-y-2\">\n                                    <li class=\"flex justify-between text-sm\"><span class=\"text-white/80 font-light\">Kirin Bier (0.33l)</span> <span class=\"text-gold\">4.5€</span></li>\n                                    <li class=\"flex justify-between text-sm\"><span class=\"text-white/80 font-light\">Sake (Kalt/Warm)</span> <span class=\"text-gold\">7€</span></li>\n                                    <li class=\"flex justify-between text-sm\"><span class=\"text-white/80 font-light\">Weißwein</span> <span class=\"text-gold\">7€</span></li>\n                                </ul>\n                            </div>\n                        </div>\n                    </div>\n\n                </div>\n            </div>\n        </section>\n\n        <!-- Location & Info Section -->\n        <section id=\"info\" class=\"relative py-24 px-6 border-t border-white/5 bg-[#0f0f0f]\">\n            <div class=\"max-w-7xl mx-auto\">\n                <div class=\"grid lg:grid-cols-12 gap-12 items-start\">\n                    \n                    <!-- Text Info -->\n                    <div class=\"lg:col-span-4 space-y-12 reveal-up\">\n                        <div>\n                            <span class=\"text-xs uppercase tracking-[0.3em] text-gold block mb-4\">Location</span>\n                            <h2 class=\"text-4xl font-light text-white mb-6\">Besuchen <span class=\"serif italic text-white/50\">Sie Uns</span></h2>\n                            <p class=\"text-white/50 font-light leading-relaxed\">\n                                Ein Ort der Ruhe und des Genusses inmitten von Hamburg. Authentische japanische Küche, serviert mit Tradition.\n                            </p>\n                        </div>\n\n                        <div class=\"space-y-8\">\n                            <div class=\"group\">\n                                <div class=\"flex items-center gap-3 mb-2\">\n                                    <iconify-icon icon=\"solar:clock-circle-linear\" class=\"text-gold\"></iconify-icon>\n                                    <h4 class=\"text-xs uppercase tracking-[0.2em] text-white\">Öffnungszeiten</h4>\n                                </div>\n                                <p class=\"text-xl text-white font-light\">MI - SA <span class=\"text-gold\">18:00 - 22:00</span></p>\n                                <p class=\"text-sm text-white/40 mt-1\">SO - DI Geschlossen</p>\n                            </div>\n\n                            <div class=\"group\">\n                                <div class=\"flex items-center gap-3 mb-2\">\n                                    <iconify-icon icon=\"solar:map-point-linear\" class=\"text-gold\"></iconify-icon>\n                                    <h4 class=\"text-xs uppercase tracking-[0.2em] text-white\">Adresse</h4>\n                                </div>\n                                <p class=\"text-lg text-white/80 font-light\">\n                                    Hamburger Berg 25<br>\n                                    20359 Hamburg<br>\n                                    GERMANY\n                                </p>\n                            </div>\n\n                             <div class=\"group\">\n                                <div class=\"flex items-center gap-3 mb-2\">\n                                    <iconify-icon icon=\"solar:phone-calling-linear\" class=\"text-gold\"></iconify-icon>\n                                    <h4 class=\"text-xs uppercase tracking-[0.2em] text-white\">Kontakt</h4>\n                                </div>\n                                <a href=\"mailto:info@kampai-hamburg.de\" class=\"text-lg text-white/80 font-light hover:text-gold transition-colors\">\n                                    info@kampai-hamburg.de\n                                </a>\n                            </div>\n                        </div>\n                    </div>\n\n                    <!-- Map -->\n                    <div class=\"lg:col-span-8 h-[500px] w-full reveal-up delay-100 relative overflow-hidden group\">\n                        <div class=\"absolute inset-0 border border-white/10 z-10 pointer-events-none group-hover:border-gold/30 transition-colors\"></div>\n                        <iframe \n                            src=\"https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2370.478839845196!2d9.95758331612443!3d53.54924398002194!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x47b18f6f04363d6b%3A0x4256246415513576!2sHamburger%20Berg%2025%2C%2020359%20Hamburg%2C%20Germany!5e0!3m2!1sen!2sus!4v1646215849521!5m2!1sen!2sus\" \n                            width=\"100%\" \n                            height=\"100%\" \n                            style=\"border:0;\" \n                            allowfullscreen=\"\" \n                            loading=\"lazy\" \n                            class=\"map-grayscale w-full h-full\"\n                        ></iframe>\n                    </div>\n\n                </div>\n            </div>\n        </section>\n\n        <!-- Footer -->\n        <footer class=\"relative py-12 px-6 border-t border-white/5 bg-black overflow-hidden\">\n             <!-- Footer Background Kanji -->\n            <div class=\"absolute top-0 right-10 text-[10rem] text-gold/5 japanese pointer-events-none leading-none select-none\">鯨</div>\n\n            <div class=\"max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-center gap-6 relative z-10\">\n                <div class=\"text-center md:text-left\">\n                    <span class=\"japanese text-2xl text-gold block mb-1\">乾杯</span>\n                    <p class=\"text-xs text-white/30 tracking-widest uppercase\">&copy; 2024 Kampai Sushi Bar Hamburg</p>\n                </div>\n                \n                <div class=\"flex gap-8\">\n                    <a href=\"#\" class=\"text-white/40 hover:text-gold transition-colors\"><iconify-icon icon=\"solar:instagram-linear\" width=\"20\"></iconify-icon></a>\n                    <a href=\"#\" class=\"text-white/40 hover:text-gold transition-colors\"><iconify-icon icon=\"solar:facebook-linear\" width=\"20\"></iconify-icon></a>\n                </div>\n\n                <div class=\"flex gap-6 text-xs text-white/30 uppercase tracking-widest\">\n                    <a href=\"#\" class=\"hover:text-gold transition-colors\">Impressum</a>\n                    <a href=\"#\" class=\"hover:text-gold transition-colors\">Datenschutz</a>\n                </div>\n            </div>\n        </footer>\n    </div>\n\n    <script>\n        document.addEventListener(\"DOMContentLoaded\", () => {\n            gsap.registerPlugin(ScrollTrigger);\n\n            // Loader Animation\n            const loader = document.getElementById('loader');\n            const loaderBar = document.getElementById('loader-bar');\n            \n            setTimeout(() => {\n                loaderBar.style.width = '100%';\n            }, 100);\n\n            setTimeout(() => {\n                loader.style.opacity = '0';\n                setTimeout(() => {\n                    loader.style.display = 'none';\n                    initAnimations();\n                }, 700);\n            }, 1500);\n\n            function initAnimations() {\n                // Parallax Hero\n                gsap.to(\".parallax-img\", {\n                    yPercent: 20,\n                    ease: \"none\",\n                    scrollTrigger: {\n                        trigger: \"#home\",\n                        start: \"top top\",\n                        end: \"bottom top\",\n                        scrub: true\n                    }\n                });\n\n                // Background Kanji Scroll Logic\n                const kanji = document.querySelector('.background-kanji');\n                const kanjiText = document.querySelector('.background-kanji__text');\n                \n                if(kanji && kanjiText) {\n                     gsap.to(kanji, {\n                        height: \"100%\",\n                        ease: \"none\",\n                        scrollTrigger: {\n                            trigger: \"body\",\n                            start: \"top top\",\n                            end: \"bottom bottom\",\n                            scrub: 0.5\n                        }\n                    });\n                }\n\n                // Reveal Animations\n                const revealElements = document.querySelectorAll(\".reveal-up\");\n                revealElements.forEach((element) => {\n                    gsap.to(element, {\n                        scrollTrigger: {\n                            trigger: element,\n                            start: \"top 85%\",\n                            toggleActions: \"play none none reverse\"\n                        },\n                        y: 0,\n                        opacity: 1,\n                        duration: 1.2,\n                        ease: \"power3.out\"\n                    });\n                });\n\n                // Navbar Hide/Show\n                let lastScroll = 0;\n                const nav = document.getElementById('navbar');\n                \n                window.addEventListener('scroll', () => {\n                    const currentScroll = window.pageYOffset;\n                    if (currentScroll > 50 && currentScroll > lastScroll) {\n                        nav.style.transform = 'translateY(-100%)';\n                    } else {\n                        nav.style.transform = 'translateY(0)';\n                    }\n                    lastScroll = currentScroll;\n                });\n            }\n        });\n    </script>\n</body>\n</html>","language":"html","username":"885cc0d1-48b5-460c-b4e0-b67d44aaaedc","created_at":"2026-02-04T01:33:14.382702+00:00","views":558,"image_url":"https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/preview-images/sushi-restaurant-58.png?t=1771829417912","forks":22,"private":false,"watermark":true,"featured":true,"share_source_code":true,"user_id":"885cc0d1-48b5-460c-b4e0-b67d44aaaedc","category":"Web","updated_at":null,"tags":["Landing Page","Food","Brand","Dark","Minimal","Large Type","Restaurant","Japanese","One Page"],"description":"Elegant dark-themed restaurant landing page template for Japanese sushi bars, featuring hero imagery, menu highlights, location details, and contact info.","premium":false,"price":null,"purchase_url":null,"long_description":"**Kampai Sushi Bar Restaurant Landing Page Template** delivers a refined, dark, minimal aesthetic ideal for Japanese restaurants and sushi bars.\n\n## What's Included\n- Full-screen hero with Japanese typography and background imagery\n- Story/philosophy section with chef highlight\n- Curated **menu highlights** grid with imagery and pricing\n- **Location & hours** block with icons and embedded Google Map\n- Footer with sitemap, legal links, and social icons\n\n## Key Features\n- **Dark, minimal, gold-accent visual style**\n- **Smooth scroll and GSAP reveal animations**\n- Mobile-responsive layout with sticky, blurred navigation\n- Menu preview cards optimized for photography\n- Ready sections for contact, legal, and social links\n\n**Primary Use Case:**\nUse this template to quickly launch a polished landing page for a sushi bar or fine-dining restaurant, showcasing ambiance, signature dishes, and essential visitor information.","custom_domain":null,"favicon_light_url":null,"favicon_dark_url":null,"dns_verified":null,"dns_verified_at":null,"dns_a_record":null,"netlify_apex_exists":null,"netlify_www_exists":null,"netlify_verified_at":null,"custom_domain_added_at":null,"netlify_site_id":null,"umami_website_id":null,"umami_share_id":null,"analytics_enabled":false,"gtm_container_id":null,"remix_source":{},"credit_remix_source":false,"search_visibility":"aura_and_custom_domain","llms_txt":null,"llms_txt_updated_at":null,"featured_at":"2026-02-04T01:33:14.382702+00:00","google_analytics_id":null,"source_revision_id":null,"published_storage_prefix":null}]